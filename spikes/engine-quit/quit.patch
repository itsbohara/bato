+
+bool SimpleHandler::OnChromeCommand(
+    CefRefPtr<CefBrowser> browser,
+    int command_id,
+    cef_window_open_disposition_t disposition) {
+  CEF_REQUIRE_UI_THREAD();
+  if (!NativeQuitExperimentEnabled() ||
+      command_id != cef_id_for_command_id_name("IDC_EXIT")) {
+    return false;
+  }
+  const bool veto =
+      !quit_vetoed_ && CefCommandLine::GetGlobalCommandLine()->HasSwitch(
+                           "bato-veto-first-quit");
+  if (veto) {
+    quit_vetoed_ = true;
+  }
+  fprintf(stderr, "{\"event\":\"sample-client-quit-command\",\"veto\":%s}\n",
+          veto ? "true" : "false");
+  return veto;
+}
+
+void SimpleHandler::RequestApplicationQuit() {
+  CEF_REQUIRE_UI_THREAD();
+  if (!NativeQuitExperimentEnabled() || is_alloy_style_) {
+    return;
+  }
+  if (quit_request_in_progress_) {
+    fprintf(stderr, "{\"event\":\"sample-native-quit-reentrant-refused\"}\n");
+    return;
+  }
+  // A synchronous command can close browsers and release their client refs.
+  CefRefPtr<SimpleHandler> keep_alive(this);
+  quit_request_in_progress_ = true;
+  struct ScopedRequestReset {
+    bool& active;
+    ~ScopedRequestReset() { active = false; }
+  } reset{quit_request_in_progress_};
+  const int command = cef_id_for_command_id_name("IDC_EXIT");
+  for (const auto& browser : browser_list_) {
+    auto host = browser->GetHost();
+    if (command >= 0 && host->CanExecuteChromeCommand(command)) {
+      fprintf(stderr, "{\"event\":\"sample-native-quit-requested\"}\n");
+      host->ExecuteChromeCommand(command, CEF_WOD_CURRENT_TAB);
+      return;
+    }
+  }
+  // No force-exit or private-selector fallback when no live target exists.
+  fprintf(stderr, "{\"event\":\"sample-native-quit-unavailable\"}\n");
+}
