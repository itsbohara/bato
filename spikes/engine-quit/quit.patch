+void RequestNativeApplicationQuit() {
+  CEF_REQUIRE_UIT();
+  if (!NSApp || ![NSApp.delegate isKindOfClass:[AppController class]]) {
+    fprintf(stderr, "{\"event\":\"native-quit-controller-unavailable\"}\n");
+    return;
+  }
+
+  AppController* controller = AppController.sharedController;
+  const bool startup_complete = controller.startupComplete;
+  fprintf(stderr,
+          "{\"event\":\"native-quit-controller-readiness\",\"startupComplete\":%s}\n",
+          startup_complete ? "true" : "false");
+  if (!startup_complete) {
+    fprintf(stderr, "{\"event\":\"native-quit-controller-startup-incomplete\"}\n");
+    return;
+  }
+  fprintf(stderr, "{\"event\":\"native-quit-controller-requested\"}\n");
+  // Framework-internal integration only. Preserve confirmation, downloads,
+  // active-app vetoes, beforeunload cancellation and controller keepalive flow.
+  [controller tryToTerminateApplication];
+  fprintf(stderr,
+          "{\"event\":\"native-quit-controller-returned\",\"tryingToQuit\":%s}\n",
+          browser_shutdown::IsTryingToQuit() ? "true" : "false");
+}
+
