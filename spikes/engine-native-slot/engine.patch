+// Reached from ChromeBrowserWebContentsDelegate::OpenURLFromTab, before CEF's
+// request handler and before Chrome opens a window. A Shift-click on a link
+// arrives as a renderer-initiated, trusted-event NEW_WINDOW navigation; a
+// window.open popup, context-menu command or script click does not.
+bool NativeSlotShiftClickLink(BrowserWindowInterface* browser, content::WebContents* source,
+                              const content::OpenURLParams& params) {
+  CEF_REQUIRE_UIT();
+  const auto callbacks = g_peek_interaction_callbacks;
+  if (!callbacks.link_requested || !browser || !source ||
+      params.disposition != WindowOpenDisposition::NEW_WINDOW ||
+      !params.is_renderer_initiated || !params.user_gesture ||
+      params.started_from_context_menu || params.is_service_worker_open_window ||
+      params.post_data ||
+      params.triggering_event_info != blink::mojom::TriggeringEventInfo::kFromTrustedEvent) {
+    return false;
+  }
+  const GURL& url = params.url;
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_host() ||
+      url.has_username() || url.has_password()) return false;
+  BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser);
+  auto found = view ? Slots().find(view) : Slots().end();
+  if (found == Slots().end()) return false;
+  const SlotState& state = found->second;
+  auto* multi = view->multi_contents_view();
+  if (!state.adapter || !state.tab_observer || !state.host || !state.host->GetVisible() ||
+      state.transitioning || state.peek_generation || !multi ||
+      multi->IsPeekPresentationActive() || multi->IsInSplitView() || view->IsFullscreen() ||
+      !view->GetWidget() || !view->GetWidget()->IsVisible() || SlotBlocked(view) ||
+      SlotClosing(view)) return false;
+  auto* model = browser->GetTabStripModel();
+  const int index = model->active_index();
+  if (index < 0 || model->GetWebContentsAt(index) != source || model->GetSplitForTab(index))
+    return false;
+  auto host = ChromeBrowserHostImpl::GetBrowserForContents(source);
+  if (!host || host->GetIdentifier() <= 0) return false;
+  const uint64_t token = state.token;
+  const int parent_id = host->GetIdentifier();
+  const std::string spec = url.spec();
+  // The client answers whether it will open the link; a decline leaves Chrome's
+  // default behavior in place. No access to Slots after client code.
+  return callbacks.link_requested(callbacks.context, token, parent_id, spec.c_str()) != 0;
+}
