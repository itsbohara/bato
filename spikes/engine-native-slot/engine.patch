+class ScopedSplitMutation {
+ public:
+  ScopedSplitMutation(BrowserView* view, uint64_t token) : view_(view), token_(token) {
+    Slots().at(view_).changing_split = true;
+  }
+  ~ScopedSplitMutation() {
+    auto found = Slots().find(view_);
+    if (found != Slots().end() && found->second.token == token_)
+      found->second.changing_split = false;
+  }
+ private:
+  BrowserView* view_;
+  uint64_t token_;
+};
+bool NativeSlotFocusAllowed(BrowserView* view) {
+  auto found = Slots().find(view);
+  return found != Slots().end() &&
+      (found->second.sidebar_mode != 0 || (view->IsFullscreen() && found->second.fullscreen_reveal)) &&
+      found->second.host && found->second.host->GetVisible() &&
+      !found->second.transitioning &&
+      (!view->IsFullscreen() || found->second.fullscreen_reveal) &&
+      view->GetWidget() && view->GetWidget()->IsVisible() && !SlotClosing(view);
