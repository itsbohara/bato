+
+bool MultiContentsView::BeginPeekPresentation(
+    content::WebContents* preview,
+    content::WebContents* parent,
+    PeekEndedCallback ended,
+    base::RepeatingClosure scrim_clicked) {
+  if (!preview || !parent || preview == parent || !ended || !scrim_clicked ||
+      IsPeekPresentationActive() || IsInSplitView() || active_index_ != 0 ||
+      contents_container_views_[1]->GetVisible() ||
+      GetActiveContentsView()->web_contents() != preview ||
+      GetInactiveContentsView()->web_contents() ||
+      GetContentsContainerViewFor(parent)) {
+    return false;
+  }
+  peek_contents_ = preview;
+  peek_parent_ = parent;
+  peek_ended_ = std::move(ended);
+  peek_scrim_clicked_ = std::move(scrim_clicked);
+
+  // The parent's container must stack below the scrim, which stacks below the
+  // preview's container. Views orders layers, hit testing and native views by
+  // child order. EndPeekPresentation restores the original order.
+  ContentsContainerView* const preview_container = contents_container_views_[0];
+  ContentsContainerView* const parent_container = contents_container_views_[1];
+  ReorderChildView(parent_container, GetIndexOf(preview_container).value());
+  ReorderChildView(peek_scrim_, GetIndexOf(preview_container).value());
+
+  parent_container->SetVisible(true);
+  ContentsWebView* const parent_view = parent_container->contents_view();
+  parent_view->SetWebContents(parent);
+  // The scrim already hides the parent from pointer input; these keep keyboard
+  // traversal and any native hit test that bypasses Views out of it as well.
+  parent_view->SetFocusBehavior(views::View::FocusBehavior::NEVER);
+  parent_view->holder()->SetProperty(views::kIsBlockedByModalKey, true);
+  // Content-layer backstop for input that bypasses Views hit testing.
+  peek_parent_input_block_.emplace(parent->IgnoreInputEvents(std::nullopt));
+  SafeInvoke(parent)
+      .Then(Overload<content::WebContents*>(
+          &tabs::TabInterface::MaybeGetFromContents))
+      .Then(&SadTabHelper::From)
+      .Then(&SadTabHelper::ReinstallInWebView);
+
+  peek_scrim_->SetVisible(true);
+  UpdateContentsBorderAndOverlay();
+  InvalidateLayout();
+  return true;
+}
+
+bool MultiContentsView::EndPeekPresentation(PeekEndReason reason) {
+  if (!IsPeekPresentationActive()) {
+    return false;
+  }
+  peek_contents_ = nullptr;
+  peek_parent_ = nullptr;
+  PeekEndedCallback ended = std::move(peek_ended_);
+  peek_scrim_clicked_.Reset();
+
+  peek_parent_input_block_.reset();
+  // Unmount before any caller attaches the parent to the active view again.
+  ContentsContainerView* const parent_container = contents_container_views_[1];
+  parent_container->contents_view()->SetWebContents(nullptr);
+  parent_container->contents_view()->SetFocusBehavior(
+      views::View::FocusBehavior::ALWAYS);
+  parent_container->SetVisible(false);
+  peek_scrim_->SetVisible(false);
+  if (reason != PeekEndReason::kTeardown) {
+    ReorderChildView(contents_container_views_[0],
+                     GetIndexOf(background_view_).value() + 1);
+    ReorderChildView(parent_container, GetIndexOf(resize_area_).value());
+    ReorderChildView(peek_scrim_, children().size() - 1);
+  }
+  UpdateContentsBorderAndOverlay();
+  InvalidateLayout();
+  // The callback may re-enter client code; touch no state afterwards.
+  std::move(ended).Run(reason);
+  return true;
+}
+
+void MultiContentsView::OnPeekScrimClicked() {
+  if (!IsPeekPresentationActive()) {
+    return;
+  }
+  // The client may end the presentation from this call.
+  base::RepeatingClosure clicked = peek_scrim_clicked_;
+  clicked.Run();
+}
