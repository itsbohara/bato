+// Downloads. One watcher per in-progress-at-creation download of each regular Profile that
+// owns a slot window. Dangerous downloads stay held by Chromium; the client decides
+// keep or discard through the action export. Chromium's own bubble is suppressed
+// separately, so nothing here depends on its models.
+namespace {
+BatoDownloadCallbacksV1 g_download_callbacks = {};
+constexpr base::TimeDelta kDownloadProgressInterval = base::Milliseconds(250);
+
+std::string DownloadProfileKey(Profile* profile) {
+  const std::string name = profile->GetPath().BaseName().AsUTF8Unsafe();
+  return name == "Default" ? std::string() : name;
+}
+
+int32_t DownloadWarning(download::DownloadItem* item) {
+  if (item->GetState() != download::DownloadItem::IN_PROGRESS) return 0;
+  if (item->IsInsecure()) return 2;
+  switch (item->GetDangerType()) {
+    case download::DOWNLOAD_DANGER_TYPE_PROMPT_FOR_SCANNING:
+    case download::DOWNLOAD_DANGER_TYPE_PROMPT_FOR_LOCAL_PASSWORD_SCANNING:
+      return 3;
+    default:
+      return item->IsDangerous() ? 1 : 0;
+  }
+}
+
+int32_t DownloadStateCode(download::DownloadItem* item) {
+  switch (item->GetState()) {
+    case download::DownloadItem::IN_PROGRESS: return item->IsPaused() ? 1 : 0;
+    case download::DownloadItem::COMPLETE: return 2;
+    case download::DownloadItem::CANCELLED: return 4;
+    default: return 3;
+  }
+}
+
+class DownloadProfile;
+class WatchedDownload final : public download::DownloadItem::Observer {
+ public:
+  WatchedDownload(DownloadProfile* owner, std::string key, download::DownloadItem* item)
+      : owner_(owner), key_(std::move(key)), item_(item) {
+    observation_.Observe(item);
+  }
+  download::DownloadItem* item() const { return item_; }
+  void Emit(bool force);
+  void OnDownloadUpdated(download::DownloadItem*) override { Emit(false); }
+  void OnDownloadRemoved(download::DownloadItem*) override;
+  void OnDownloadDestroyed(download::DownloadItem*) override;
+ private:
+  struct Shape {
+    int32_t state = -1, can_resume = -1, exists = -1, warning = -1;
+    std::string filename;
+    bool operator==(const Shape&) const = default;
+  };
+  DownloadProfile* owner_;
+  const std::string key_;
+  raw_ptr<download::DownloadItem> item_;
+  base::ScopedObservation<download::DownloadItem, download::DownloadItem::Observer> observation_{this};
+  base::TimeTicks last_emit_;
+  Shape last_shape_;
+};
+
+class DownloadProfile final : public content::DownloadManager::Observer {
+ public:
+  DownloadProfile(Profile* profile, std::string key)
+      : profile_(profile), key_(std::move(key)), manager_(profile->GetDownloadManager()) {
+    manager_->AddObserver(this);
+    std::vector<raw_ptr<download::DownloadItem, VectorExperimental>> existing;
+    manager_->GetAllDownloads(&existing);
+    for (auto item : existing) Watch(item);
+  }
+  ~DownloadProfile() override {
+    if (manager_) manager_->RemoveObserver(this);
+  }
+  const std::string& key() const { return key_; }
+  content::DownloadManager* manager() const { return manager_; }
+  void Replay() {
+    for (auto& [id, watch] : watched_) watch->Emit(true);
+  }
+  void Forget(const std::string& id) { watched_.erase(id); }
+  void OnDownloadCreated(content::DownloadManager*, download::DownloadItem* item) override { Watch(item); }
+  void ManagerGoingDown(content::DownloadManager*) override;
+ private:
+  void Watch(download::DownloadItem* item) {
+    // History items load as finished: they stay in chrome://downloads, not the sidebar.
+    if (item->GetState() != download::DownloadItem::IN_PROGRESS || item->IsTransient() ||
+        watched_.contains(item->GetGuid())) return;
+    auto watch = std::make_unique<WatchedDownload>(this, key_, item);
+    auto* raw = watch.get();
+    watched_[item->GetGuid()] = std::move(watch);
+    raw->Emit(true);
+  }
+  Profile* const profile_;
+  const std::string key_;
+  raw_ptr<content::DownloadManager> manager_;
+  std::map<std::string, std::unique_ptr<WatchedDownload>> watched_;
+};
+
+auto& DownloadProfiles() {
+  static base::NoDestructor<std::map<Profile*, std::unique_ptr<DownloadProfile>>> profiles;
+  return *profiles;
+}
+
+void WatchedDownload::Emit(bool force) {
+  if (!g_download_callbacks.upserted) return;
+  const std::string name = item_->GetTargetFilePath().empty()
+      ? item_->GetFileNameToReportUser().AsUTF8Unsafe()
+      : item_->GetTargetFilePath().BaseName().AsUTF8Unsafe();
+  Shape shape;
+  shape.state = DownloadStateCode(item_);
+  shape.can_resume = item_->CanResume() ? 1 : 0;
+  shape.exists = item_->GetFileExternallyRemoved() ? 0 : 1;
+  shape.warning = DownloadWarning(item_);
+  shape.filename = name;
+  const auto now = base::TimeTicks::Now();
+  if (!force && shape == last_shape_ && now - last_emit_ < kDownloadProgressInterval) return;
+  last_emit_ = now;
+  last_shape_ = shape;
+  const std::string id = item_->GetGuid();
+  const std::string path = (item_->GetState() == download::DownloadItem::COMPLETE
+                                ? item_->GetFullPath() : item_->GetTargetFilePath()).AsUTF8Unsafe();
+  BatoDownloadInfoV1 info = {};
+  info.size = sizeof(info);
+  info.profile_key = key_.c_str();
+  info.id = id.c_str();
+  info.filename = name.c_str();
+  info.path = path.c_str();
+  info.received_bytes = item_->GetReceivedBytes();
+  info.total_bytes = item_->GetTotalBytes() > 0 ? item_->GetTotalBytes() : -1;
+  info.bytes_per_second = item_->CurrentSpeed();
+  info.state = shape.state;
+  info.can_resume = shape.can_resume;
+  info.file_exists = shape.exists;
+  info.warning = shape.warning;
+  g_download_callbacks.upserted(g_download_callbacks.context, &info);
+}
+
+void WatchedDownload::OnDownloadRemoved(download::DownloadItem*) {
+  if (g_download_callbacks.removed) {
+    const std::string id = item_->GetGuid();
+    g_download_callbacks.removed(g_download_callbacks.context, key_.c_str(), id.c_str());
+  }
+}
+
+void WatchedDownload::OnDownloadDestroyed(download::DownloadItem*) {
+  const std::string id = item_->GetGuid();
+  observation_.Reset();
+  item_ = nullptr;
+  owner_->Forget(id);  // Deletes this.
+}
+
+void DownloadProfile::ManagerGoingDown(content::DownloadManager*) {
+  manager_->RemoveObserver(this);
+  manager_ = nullptr;
+  watched_.clear();
+  auto self = DownloadProfiles().find(profile_);
+  if (self != DownloadProfiles().end()) {
+    // Erasing destroys this; nothing may touch members afterwards.
+    auto owned = std::move(self->second);
+    DownloadProfiles().erase(self);
+  }
+}
+
+void WatchDownloads(Profile* profile) {
+  if (!g_download_callbacks.upserted || !profile || profile->IsOffTheRecord() ||
+      DownloadProfiles().contains(profile)) return;
+  const std::string key = DownloadProfileKey(profile);
+  DownloadProfiles()[profile] = std::make_unique<DownloadProfile>(profile, key);
+  fprintf(stderr, "{\"event\":\"native-downloads-watching\",\"profile_key\":\"%s\"}\n", key.c_str());
+}
+
+download::DownloadItem* FindDownload(const std::string& key, const std::string& id) {
+  for (auto& [profile, watched] : DownloadProfiles()) {
+    if (watched->key() == key && watched->manager()) return watched->manager()->GetDownloadByGuid(id);
+  }
+  return nullptr;
+}
