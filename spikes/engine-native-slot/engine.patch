+// Ends an owned presentation for an engine-side reason. Safe when none exists.
+void EndPeek(BrowserView* view, MultiContentsView::PeekEndReason reason) {
+  auto* multi = view->multi_contents_view();
+  if (multi && multi->EndPeekPresentation(reason)) return;
+  // The policy is gone (or never took hold); still release and report the state.
+  auto found = Slots().find(view);
+  if (found == Slots().end() || !found->second.peek_generation) return;
+  PeekEnded(view, found->second.token, found->second.peek_generation, reason);
+}
+
+// A click on the scrim asks the client to dismiss; the engine never ends the
+// presentation itself so the client's beforeunload-aware path stays in charge.
+void PeekScrimClicked(BrowserView* view, uint64_t token, uint64_t generation) {
+  const auto callbacks = g_peek_interaction_callbacks;
+  auto found = Slots().find(view);
+  if (!callbacks.scrim_clicked || found == Slots().end() ||
+      found->second.token != token || found->second.peek_generation != generation) return;
+  const int parent = found->second.peek_parent, preview = found->second.peek_preview;
+  // No access to Slots after client code.
+  callbacks.scrim_clicked(callbacks.context, token, generation, parent, preview);
+}
+
+// Tab mutations can silently break the presentation's premises. The view layer
+// ends it for selection/detach; this also covers the parent and split pairing.
+void RevalidatePeek(uint64_t token) {
+  for (const auto& [view, state] : Slots()) {
+    if (state.token != token) continue;
+    if (!state.peek_generation) return;
+    using Reason = MultiContentsView::PeekEndReason;
+    auto* model = view->browser()->GetTabStripModel();
+    auto parent = BrowserInSlot(view, state.peek_parent);
+    auto preview = BrowserInSlot(view, state.peek_preview);
+    const int parent_index = parent ? model->GetIndexOfWebContents(parent->GetWebContents()) : TabStripModel::kNoTab;
+    const int preview_index = preview ? model->GetIndexOfWebContents(preview->GetWebContents()) : TabStripModel::kNoTab;
+    BrowserView* const owner = view;
+    if (SlotClosing(owner)) return EndPeek(owner, Reason::kClosing);
+    if (preview_index < 0) return EndPeek(owner, Reason::kPreviewClosed);
+    if (parent_index < 0) return EndPeek(owner, Reason::kParentClosed);
+    if (model->GetSplitForTab(parent_index) || model->GetSplitForTab(preview_index))
+      return EndPeek(owner, Reason::kSplit);
+    if (model->active_index() != preview_index) return EndPeek(owner, Reason::kSelectionChanged);
+    return;
+  }
+}
