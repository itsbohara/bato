+// token is process-local, unique per attempted window slot and never persisted.
+typedef struct BatoNativeSlotCallbacksV1 {
+  size_t size;
+  uint32_t version;
+  void* context;
+  void* (*create)(void* context, uint64_t token);
+  void (*detached)(void* context, uint64_t token);
