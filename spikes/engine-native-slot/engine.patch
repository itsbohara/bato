+extern "C" CEF_EXPORT int bato_native_slot_register_v1(
+    const BatoNativeSlotCallbacksV1* callbacks) {
+  if (!NSThread.isMainThread || g_slot_callbacks.version ||
+      g_slot_registration_closed || (CefContext::Get() && CefContext::Get()->initialized()) || !callbacks ||
+      callbacks->size != sizeof(BatoNativeSlotCallbacksV1) ||
+      callbacks->version != 1 || !callbacks->create || !callbacks->detached ||
+      !callbacks->focus_target) return 0;
+  g_slot_callbacks = *callbacks;
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_active_browser_id_v1(uint64_t token) {
+  if (!NSThread.isMainThread) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view) return 0;
+  auto* contents = view->GetActiveWebContents();
+  if (!contents) return 0;
+  auto browser = ChromeBrowserHostImpl::GetBrowserForContents(contents);
+  return browser ? browser->GetIdentifier() : 0;
+}
+extern "C" CEF_EXPORT int bato_native_slot_register_page_callbacks_v1(
+    const BatoPageCallbacksV1* callbacks) {
+  if (!NSThread.isMainThread || g_page_callbacks.version ||
+      g_slot_registration_closed || (CefContext::Get() && CefContext::Get()->initialized()) ||
+      !callbacks || callbacks->size != sizeof(BatoPageCallbacksV1) ||
+      callbacks->version != 1 || !callbacks->close_cancelled ||
+      !callbacks->active_changed) return 0;
+  g_page_callbacks = *callbacks;
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_new_tab_v1(uint64_t token) {
+  if (!NSThread.isMainThread || browser_shutdown::IsTryingToQuit()) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view || !view->GetActiveWebContents()) return 0;
+  // FindSlot also refuses creation/recovery while this window is closing.
+  auto anchor = ChromeBrowserHostImpl::GetBrowserForContents(view->GetActiveWebContents());
+  if (!anchor || !anchor->CanExecuteChromeCommand(IDC_NEW_TAB)) return 0;
+  // The pinned normal-window command invokes this synchronous helper. Its
+  // returned contents is the inserted tab, not an inferred later callback.
+  auto* contents = &chrome::NewTab(view->browser(), NewTabTypes::kNewTabCommand);
+  BrowserView* current = FindSlot(token);  // Client callbacks may re-enter.
+  if (!current || current != view ||
+      current->browser()->GetTabStripModel()->GetIndexOfWebContents(contents) ==
+          TabStripModel::kNoTab) return 0;
+  auto created = ChromeBrowserHostImpl::GetBrowserForContents(contents);
+  return created && created->GetIdentifier() != anchor->GetIdentifier()
+      ? created->GetIdentifier() : 0;
+}
+extern "C" CEF_EXPORT int bato_native_slot_request_close_v1(
+    uint64_t token, int browser_id) {
+  if (!NSThread.isMainThread || !g_page_callbacks.close_cancelled) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view) return 0;
+  auto browser = BrowserInSlot(view, browser_id);
+  if (!browser) return 0;
+  auto* contents = browser->GetWebContents();
+  if (!contents) return 0;
+  contents->SetUserData(&kPageCloseObserverKey,
+      std::make_unique<PageCloseObserver>(contents, token, browser_id));
+  browser->CloseBrowser(false);  // Preserve the default dialog and beforeunload.
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_focus_native_v1(uint64_t token) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT()) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view || !view->GetFocusManager()) return 0;
+  auto* host = Slots().at(view).host;
+  host->RequestFocus();  // NativeViewHost::OnFocus enters ViewsHostable focus.
+  // Focus callbacks can re-enter client code and destroy the original window.
+  BrowserView* current = FindSlot(token);
+  if (!current || !current->GetFocusManager()) return 0;
+  return current->GetFocusManager()->GetFocusedView() == Slots().at(current).host ? 1 : 0;
+}
+extern "C" CEF_EXPORT int bato_native_slot_focus_browser_v1(uint64_t token) {
+  if (!NSThread.isMainThread) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view || !view->GetActiveWebContents()) return 0;
+  view->GetActiveWebContents()->Focus();
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_advance_focus_v1(uint64_t token, int reverse) {
+  if (!NSThread.isMainThread) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view) return 0;
+  auto* focus = view->GetFocusManager();
+  focus->SetFocusedView(Slots().at(view).host);
+  focus->AdvanceFocus(reverse != 0);
+  return 1;
+}
