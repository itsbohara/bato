+extern "C" CEF_EXPORT int bato_native_slot_present_split_v1(
+    uint64_t token, int left_id, int right_id, int focused_id, double ratio) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || left_id <= 0 ||
+      right_id <= 0 || left_id == right_id ||
+      (focused_id != left_id && focused_id != right_id) ||
+      !std::isfinite(ratio) || ratio <= 0 || ratio >= 1) return 0;
+  auto* view = FindSlot(token);
+  if (!view) return 0;
+  auto left = BrowserInSlot(view, left_id), right = BrowserInSlot(view, right_id);
+  if (!left || !right || !left->GetRequestContext()->IsSame(right->GetRequestContext())) return 0;
+  auto* model = view->browser()->GetTabStripModel();
+  if (!model->delegate()->IsTabStripEditable()) return 0;
+  int li = model->GetIndexOfWebContents(left->GetWebContents());
+  int ri = model->GetIndexOfWebContents(right->GetWebContents());
+  if (li < 0 || ri < 0 || model->IsTabPinned(li) != model->IsTabPinned(ri) ||
+      model->GetTabGroupForTab(li) != model->GetTabGroupForTab(ri)) return 0;
+  auto ls = model->GetSplitForTab(li), rs = model->GetSplitForTab(ri);
+  auto& state = Slots().at(view);
+  // Never adopt/destroy another native split, including an externally created one.
+  if ((ls || rs) && !(ls && ls == rs && state.split_left == left_id && state.split_right == right_id)) return 0;
+  ScopedSplitMutation mutation(view, token);
+  if (state.split_left && (state.split_left != left_id || state.split_right != right_id)) {
+    auto old_left = BrowserInSlot(view, state.split_left);
+    auto old_right = BrowserInSlot(view, state.split_right);
+    const int oi = old_left ? model->GetIndexOfWebContents(old_left->GetWebContents()) : -1;
+    const int oj = old_right ? model->GetIndexOfWebContents(old_right->GetWebContents()) : -1;
+    auto old_split = oi >= 0 ? model->GetSplitForTab(oi) : std::nullopt;
+    if (old_split && oj >= 0 && model->GetSplitForTab(oj) == old_split)
+      model->RemoveSplit(*old_split);
+    if (FindSlot(token) != view) return 0;
+    Slots().at(view).split_left = Slots().at(view).split_right = 0;
+    li = model->GetIndexOfWebContents(left->GetWebContents());
+    ri = model->GetIndexOfWebContents(right->GetWebContents());
+    if (li < 0 || ri < 0) return 0;
+  }
+  auto split = ls.value_or(split_tabs::SplitTabId::CreateEmpty());
+  if (!ls) split = model->AddToNewSplit({li, ri},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide, ratio),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  if (FindSlot(token) != view) return 0;
+  li = model->GetIndexOfWebContents(left->GetWebContents());
+  ri = model->GetIndexOfWebContents(right->GetWebContents());
+  if (li < 0 || ri < 0 || model->GetSplitForTab(li) != split ||
+      model->GetSplitForTab(ri) != split) return 0;
+  if (li > ri) model->ReverseTabsInSplit(split);
+  if (FindSlot(token) != view) return 0;
+  li = model->GetIndexOfWebContents(left->GetWebContents());
+  ri = model->GetIndexOfWebContents(right->GetWebContents());
+  if (li < 0 || ri < 0 || model->GetSplitForTab(li) != split ||
+      model->GetSplitForTab(ri) != split) return 0;
+  model->UpdateSplitRatio(split, ratio);
+  if (FindSlot(token) != view) return 0;
+  li = model->GetIndexOfWebContents(left->GetWebContents());
+  ri = model->GetIndexOfWebContents(right->GetWebContents());
+  if (li < 0 || ri < 0 || model->GetSplitForTab(li) != split ||
+      model->GetSplitForTab(ri) != split) return 0;
+  model->ActivateTabAt(focused_id == left_id ? li : ri);
+  auto current = Slots().find(view);
+  if (current == Slots().end() || current->second.token != token) return 0;
+  li = model->GetIndexOfWebContents(left->GetWebContents());
+  ri = model->GetIndexOfWebContents(right->GetWebContents());
+  if (li < 0 || ri < 0 || model->GetSplitForTab(li) != split ||
+      model->GetSplitForTab(ri) != split) return 0;
+  current->second.split_left = left_id;
+  current->second.split_right = right_id;
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_separate_split_v1(uint64_t token) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto* view = FindSlot(token);
+  if (!view) return 0;
+  auto& state = Slots().at(view);
+  auto left = BrowserInSlot(view, state.split_left);
+  auto right = BrowserInSlot(view, state.split_right);
+  auto* model = view->browser()->GetTabStripModel();
+  if (!model->delegate()->IsTabStripEditable()) return 0;
+  const int li = left ? model->GetIndexOfWebContents(left->GetWebContents()) : -1;
+  const int ri = right ? model->GetIndexOfWebContents(right->GetWebContents()) : -1;
+  auto split = li >= 0 ? model->GetSplitForTab(li) : std::nullopt;
+  // Only remove this exact managed pair. A surviving unrelated split is untouched.
+  const bool matched = split && ri >= 0 && model->GetSplitForTab(ri) == split;
+  state.split_left = state.split_right = 0;
+  if (matched) model->RemoveSplit(*split);
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_focus_native_v1(uint64_t token) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT()) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view || !view->GetFocusManager() || Slots().at(view).sidebar_mode == 0) return 0;
+  auto* host = Slots().at(view).host;
+  host->RequestFocus();  // NativeViewHost::OnFocus enters ViewsHostable focus.
+  // Focus callbacks can re-enter client code and destroy the original window.
+  BrowserView* current = FindSlot(token);
+  if (!current || !current->GetFocusManager()) return 0;
+  return current->GetFocusManager()->GetFocusedView() == Slots().at(current).host ? 1 : 0;
+}
