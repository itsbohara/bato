+// Runs from MultiContentsView after the presentation already ended. A requested
+// end clears the state first, so the generation check makes this a no-op there.
+void PeekEnded(BrowserView* view, uint64_t token, uint64_t generation,
+               MultiContentsView::PeekEndReason reason) {
+  auto found = Slots().find(view);
+  if (found == Slots().end() || found->second.token != token ||
+      found->second.peek_generation != generation) return;
+  const int parent = found->second.peek_parent, preview = found->second.peek_preview;
+  found->second.peek_generation = 0;
+  found->second.peek_parent = found->second.peek_preview = 0;
+  const auto callbacks = g_peek_callbacks;
+  // No access to Slots after client code, which can tear the window down.
+  if (callbacks.ended) {
+    callbacks.ended(callbacks.context, token, generation, parent, preview,
+                    PeekReasonCode(reason));
+  }
+}
