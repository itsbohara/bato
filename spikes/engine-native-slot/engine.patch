+int PeekReasonCode(MultiContentsView::PeekEndReason reason) {
+  using Reason = MultiContentsView::PeekEndReason;
+  switch (reason) {
+    case Reason::kPreviewClosed: return BATO_PEEK_ENDED_PREVIEW_CLOSED;
+    case Reason::kSelectionChanged: return BATO_PEEK_ENDED_SELECTION_CHANGED;
+    case Reason::kFullscreen: return BATO_PEEK_ENDED_FULLSCREEN;
+    case Reason::kModal: return BATO_PEEK_ENDED_MODAL;
+    case Reason::kSplit: return BATO_PEEK_ENDED_SPLIT;
+    case Reason::kParentClosed: return BATO_PEEK_ENDED_PARENT_CLOSED;
+    case Reason::kClosing: return BATO_PEEK_ENDED_CLOSING;
+    case Reason::kTeardown:
+    case Reason::kRequested: break;
+  }
+  return BATO_PEEK_ENDED_TEARDOWN;
+}
