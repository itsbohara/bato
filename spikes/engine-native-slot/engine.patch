+BrowserView* FindSlot(uint64_t token, bool allow_fullscreen = false) {
+  for (const auto& [view, state] : Slots()) {
+    if (state.token == token && state.host && !state.transitioning &&
+        state.host->GetVisible() && view->GetWidget() &&
+        view->GetWidget()->IsVisible() && (allow_fullscreen || !view->IsFullscreen()) &&
+        !SlotBlocked(view) && !SlotClosing(view)) return view;
+    if (state.token == token) LogSlotRejection(view, state);
+  }
+  return nullptr;
+}
+void NotifyActivePage(uint64_t token, content::WebContents* contents) {
+  // Never publish automatic close-all/Quit selection into saved organization.
+  for (const auto& [view, state] : Slots()) {
+    if (state.token != token || !state.adapter || SlotClosing(view)) continue;
+    const auto callbacks = g_page_callbacks;
+    if (!callbacks.active_changed) return;
+    auto browser = contents ? ChromeBrowserHostImpl::GetBrowserForContents(contents) : nullptr;
+    const int identifier = browser ? browser->GetIdentifier() : 0;
+    if (identifier <= 0) return;  // Skip transient insertion/no-active host states.
+    // The presented preview is transient; it must never look like organization selection.
+    if (state.peek_generation && state.peek_preview == identifier) return;
+    // Client posts this notification before making any tab-strip mutations.
+    callbacks.active_changed(callbacks.context, token, identifier);
+    return;  // No access to SlotState after potentially reentrant client code.
+  }
+}
+CefRefPtr<ChromeBrowserHostImpl> BrowserInSlot(BrowserView* view, int identifier) {
+  auto* tabs = view->browser()->GetTabStripModel();
+  for (int index = 0; index < tabs->count(); ++index) {
+    auto browser = ChromeBrowserHostImpl::GetBrowserForContents(tabs->GetWebContentsAt(index));
+    if (browser && browser->GetIdentifier() == identifier) return browser;
+  }
+  return nullptr;
+}
