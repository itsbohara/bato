+extern "C" CEF_EXPORT uint64_t bato_native_slot_peek_present_v1(
+    uint64_t token, int parent_id, int preview_id) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || !g_peek_callbacks.ended ||
+      parent_id <= 0 || preview_id <= 0 || parent_id == preview_id) return 0;
+  BrowserView* view = FindSlot(token);
+  if (!view) return 0;
+  auto* multi = view->multi_contents_view();
+  auto& state = Slots().at(view);
+  // One presentation per window; never replace one or adopt an existing split.
+  if (!state.tab_observer || state.peek_generation || !multi ||
+      multi->IsPeekPresentationActive() || multi->IsInSplitView()) return 0;
+  auto parent = BrowserInSlot(view, parent_id), preview = BrowserInSlot(view, preview_id);
+  if (!parent || !preview ||
+      !parent->GetRequestContext()->IsSame(preview->GetRequestContext())) return 0;
+  auto* model = view->browser()->GetTabStripModel();
+  const int parent_index = model->GetIndexOfWebContents(parent->GetWebContents());
+  const int preview_index = model->GetIndexOfWebContents(preview->GetWebContents());
+  if (parent_index < 0 || preview_index < 0 || model->GetSplitForTab(parent_index) || model->GetSplitForTab(preview_index)) return 0;
+  // Closing the active preview then selects the parent rather than a neighbor.
+  model->SetOpenerOfTabAt(preview_index, model->GetTabAtIndex(parent_index));
+  if (model->active_index() != preview_index) model->ActivateTabAt(preview_index);
+  // Selection runs client and Views code. Revalidate everything.
+  auto current = FindSlot(token);
+  if (current != view) return 0;
+  multi = view->multi_contents_view();
+  auto parent_now = BrowserInSlot(view, parent_id), preview_now = BrowserInSlot(view, preview_id);
+  const int preview_after = preview_now ? model->GetIndexOfWebContents(preview_now->GetWebContents())
+                             : TabStripModel::kNoTab;
+  const int parent_after = parent_now ? model->GetIndexOfWebContents(parent_now->GetWebContents())
+                            : TabStripModel::kNoTab;
+  const uint64_t generation = ++g_peek_generation;
+  bool presented = false;
+  if (multi && preview_after >= 0 && parent_after >= 0 && preview_after == model->active_index() &&
+      !model->GetSplitForTab(parent_after) && !model->GetSplitForTab(preview_after) &&
+      Slots().at(view).token == token) {
+    presented = multi->BeginPeekPresentation(
+        preview_now->GetWebContents(), parent_now->GetWebContents(),
+        base::BindOnce(&PeekEnded, view, token, generation),
+        base::BindRepeating(&PeekScrimClicked, view, token, generation));
+  }
+  if (!presented) {
+    if (parent_after >= 0 && model->active_index() != parent_after && FindSlot(token) == view)
+      model->ActivateTabAt(parent_after);
+    return 0;
+  }
+  auto& now = Slots().at(view);
+  now.peek_generation = generation;
+  now.peek_parent = parent_id;
+  now.peek_preview = preview_id;
+  return generation;
+}
+extern "C" CEF_EXPORT int bato_native_slot_peek_end_v1(
+    uint64_t token, uint64_t generation, int restore_parent) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || !generation) return 0;
+  BrowserView* view = nullptr;
+  for (const auto& [candidate, state] : Slots()) {
+    // Deliberately not FindSlot: ending only restores normal layout and must
+    // remain possible in modal, fullscreen and closing states.
+    if (state.token == token && state.peek_generation == generation) view = candidate;
+  }
+  if (!view) return 0;
+  auto& state = Slots().at(view);
+  const int parent_id = state.peek_parent;
+  state.peek_generation = 0;  // Makes the view's own end notification a no-op.
+  state.peek_parent = state.peek_preview = 0;
+  if (auto* multi = view->multi_contents_view()) {
+    multi->EndPeekPresentation(MultiContentsView::PeekEndReason::kRequested);
+  }
+  if (!restore_parent) return 1;
+  if (FindSlot(token) != view) return 2;
+  auto parent = BrowserInSlot(view, parent_id);
+  auto* model = view->browser()->GetTabStripModel();
+  const int parent_index = parent ? model->GetIndexOfWebContents(parent->GetWebContents())
+                        : TabStripModel::kNoTab;
+  if (parent_index < 0) return 2;
+  if (model->active_index() != parent_index) model->ActivateTabAt(parent_index);
+  auto current = Slots().find(view);
+  if (current == Slots().end() || current->second.token != token) return 2;
+  return model->active_index() == parent_index ? 1 : 2;
+}
+
+extern "C" CEF_EXPORT int bato_native_slot_set_sidebar_v1(
+    uint64_t token, int width, int mode) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || mode < 0 || mode > 2) return 0;
+  BrowserView* view = FindSlot(token, /*allow_fullscreen=*/true);
+  if (!view) return 0;
+  auto& state = Slots().at(view);
+  const int clamped_width = std::clamp(width, 220, 400);
+  if (view->IsFullscreen()) {
+    // Mode 2 reveals the sidebar over the page; any other mode returns it to the hover edge.
+    const bool reveal = mode == 2;
+    if (state.fullscreen_reveal == reveal && state.sidebar_width == clamped_width) return 1;
+    state.sidebar_width = clamped_width;
+    state.fullscreen_reveal = reveal;
+    fprintf(stderr, "{\"event\":\"native-sidebar-fullscreen\",\"reveal\":%s}\n", reveal ? "true" : "false");
+    view->InvalidateLayout();
+    view->DeprecatedLayoutImmediately();
+    auto current = Slots().find(view);
+    return current != Slots().end() && current->second.token == token ? 1 : 0;
+  }
+  if (state.sidebar_width == clamped_width && state.sidebar_mode == mode) return 1;
+  // Relinquish native focus before collapsing its editable descendants.
+  if (mode == 0 && view->GetActiveWebContents()) view->GetActiveWebContents()->Focus();
+  // Focus can invoke native callbacks. Revalidate before touching the window.
+  if (FindSlot(token) != view) return 0;
+  Slots().at(view).sidebar_width = clamped_width;
+  Slots().at(view).sidebar_mode = mode;
+  fprintf(stderr, "{\"event\":\"native-sidebar-geometry\",\"width\":%d,\"mode\":%d}\n",
+          clamped_width, mode);
+  view->InvalidateLayout();
+  view->DeprecatedLayoutImmediately();
+  // Layout enters native client code. Only inspect a fresh lifetime lookup;
+  // a new modal block does not undo the already-accepted geometry request.
+  auto current = Slots().find(view);
+  return current != Slots().end() && current->second.token == token ? 1 : 0;
+}
+
+extern "C" CEF_EXPORT int bato_native_slot_delete_profile_v1(const char* profile_key) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || !profile_key || !g_browser_process) return 0;
+  // Only a UUID directory name is ever deleted: never "Default", a path, or another profile directory.
+  const std::string key = profile_key;
+  if (key.size() != 36) return 0;
+  for (size_t i = 0; i < key.size(); ++i) {
+    const char c = key[i];
+    const bool dash = i == 8 || i == 13 || i == 18 || i == 23;
+    if (dash ? c != '-' : !((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F'))) return 0;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) return 0;
+  const base::FilePath path = manager->user_data_dir().Append(key);
+  Profile* profile = manager->GetProfileByPath(path);
+  if (!profile || profile->IsOffTheRecord() || profile->GetPath() != path) return 0;
+  fprintf(stderr, "{\"event\":\"profile-delete-closing\",\"key\":\"%s\"}\n", key.c_str());
+  // The user already confirmed, so unload handlers are skipped. Chromium's own profile deletion then
+  // wipes browsing data and removes the directory; it needs another loaded Profile (the launch Profile).
+  chrome::CloseAllBrowsersWithProfile(
+      profile, /*skip_beforeunload=*/true,
+      base::BindRepeating(
+          [](const base::FilePath& closed) {
+            g_browser_process->profile_manager()->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+                closed, base::DoNothing(), ProfileMetrics::DELETE_PROFILE_SETTINGS);
+            fprintf(stderr, "{\"event\":\"profile-delete-scheduled-engine\"}\n");
+          }));
+  return 1;
+}
