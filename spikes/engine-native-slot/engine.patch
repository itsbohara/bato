+extern "C" CEF_EXPORT int bato_native_slot_register_download_callbacks_v1(
+    const BatoDownloadCallbacksV1* callbacks) {
+  if (!NSThread.isMainThread || g_download_callbacks.version ||
+      g_slot_registration_closed || (CefContext::Get() && CefContext::Get()->initialized()) ||
+      !callbacks || callbacks->size != sizeof(BatoDownloadCallbacksV1) ||
+      callbacks->version != 1 || !callbacks->upserted || !callbacks->removed) return 0;
+  g_download_callbacks = *callbacks;
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_download_snapshot_v1(void) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || !g_download_callbacks.upserted) return 0;
+  for (const auto& [view, state] : Slots()) WatchDownloads(view->browser()->GetProfile());
+  // Replay may reach client code; walk a copy of the keys, not the live map.
+  std::vector<Profile*> profiles;
+  for (const auto& [profile, watched] : DownloadProfiles()) profiles.push_back(profile);
+  for (Profile* profile : profiles) {
+    auto found = DownloadProfiles().find(profile);
+    if (found != DownloadProfiles().end()) found->second->Replay();
+  }
+  return 1;
+}
+extern "C" CEF_EXPORT int bato_native_slot_download_action_v1(
+    const char* profile_key, const char* id, int action) {
+  if (!NSThread.isMainThread || !CEF_CURRENTLY_ON_UIT() || !profile_key || !id) return 0;
+  download::DownloadItem* item = FindDownload(profile_key, id);
+  if (!item) return 0;
+  const bool in_progress = item->GetState() == download::DownloadItem::IN_PROGRESS;
+  const int32_t warning = DownloadWarning(item);
+  switch (action) {
+    case 0:
+      if (!in_progress || item->IsPaused() || warning) return 0;
+      item->Pause();
+      return 1;
+    case 1:
+      if (!item->CanResume() || warning) return 0;
+      item->Resume(true);
+      return 1;
+    case 2:
+      if (!in_progress || warning) return 0;
+      item->Cancel(true);
+      return 1;
+    case 3:
+      if (item->GetState() != download::DownloadItem::COMPLETE ||
+          item->GetFileExternallyRemoved()) return 0;
+      item->OpenDownload();
+      return 1;
+    case 4:
+      if (item->GetFullPath().empty() && item->GetTargetFilePath().empty()) return 0;
+      item->ShowDownloadInShell();
+      return 1;
+    case 5:
+      if (in_progress && !item->IsPaused()) return 0;
+      item->Remove();
+      return 1;
+    case 6: {
+      if (!warning) return 0;
+      DownloadItemModel model(item);
+      if (warning == 3) model.CompleteSafeBrowsingScan();
+      if (item->IsInsecure()) item->ValidateInsecureDownload();
+      else item->ValidateDangerousDownload();
+      return 1;
+    }
+    case 7:
+      if (!warning) return 0;
+      item->Remove();
+      return 1;
+    default:
+      return 0;
+  }
+}
