+          "{\"event\":\"native-slot-rejected\",\"reason\":\"%s\","
+          "\"host_visible\":%s,\"transitioning\":%s,\"widget_available\":%s,"
+          "\"app_modal\":%s,\"attached_sheet\":%s,\"tab_blocked\":%s,"
+          "\"web_dialog_active\":%s,\"lifecycle_closing\":%s}\n",
+          reason, visible ? "true" : "false", state.transitioning ? "true" : "false",
+          widget ? "true" : "false", app_modal ? "true" : "false",
+          sheet ? "true" : "false", tab_blocked ? "true" : "false",
+          web_dialog ? "true" : "false", closing ? "true" : "false");
