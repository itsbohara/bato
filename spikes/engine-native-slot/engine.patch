+// Read-only observations deliberately do not use FindSlot: a fullscreen or
+// modal transition must not be mistaken for native separation.
+void NotifyManagedSplit(uint64_t token) {
+  for (auto& [view, state] : Slots()) {
+    if (state.token != token || state.changing_split || !state.split_left ||
+        !state.split_right || SlotClosing(view)) continue;
+    auto left = BrowserInSlot(view, state.split_left);
+    auto right = BrowserInSlot(view, state.split_right);
+    auto* model = view->browser()->GetTabStripModel();
+    const int li = left ? model->GetIndexOfWebContents(left->GetWebContents()) : TabStripModel::kNoTab;
+    const int ri = right ? model->GetIndexOfWebContents(right->GetWebContents()) : TabStripModel::kNoTab;
+    auto split = li >= 0 ? model->GetSplitForTab(li) : std::nullopt;
+    const bool valid = split && ri >= 0 && model->GetSplitForTab(ri) == split;
+    int left_id = state.split_left, right_id = state.split_right;
+    double ratio = 0;
+    if (valid) {
+      auto* data = model->GetSplitData(*split);
+      if (!data || data->ListTabs().size() != 2) return;
+      // A native swap reverses the logical ratio. Bato's persisted order remains
+      // stable; the next explicit presentation restores that order.
+      ratio = data->visual_data()->split_ratio();
+      if (li > ri) ratio = 1.0 - ratio;
+    } else {
+      state.split_left = state.split_right = 0;
+      left_id = right_id = 0;
+    }
+    const auto callbacks = g_split_callbacks;
+    if (callbacks.changed) callbacks.changed(callbacks.context, token, left_id, right_id, ratio);
+    return;
+  }
+}
