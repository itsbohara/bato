+class SlotTabObserver final : public TabStripModelObserver {
+ public:
+  SlotTabObserver(TabStripModel* model, uint64_t token) : token_(token) {
+    model->AddObserver(this);
+  }
+  void OnTabStripModelChanged(TabStripModel* model,
+                             const TabStripModelChange& change,
+                             const TabStripSelectionChange& selection) override {
+    if (selection.active_tab_changed()) NotifyActivePage(token_, selection.new_contents);
+  }
+ private:
+  const uint64_t token_;
+  // The base observer tracks model destruction and removes itself on teardown.
+};
+struct SlotState {
+  gfx::Rect bounds;
+  uint64_t token = 0;
+  bool attempted = false;
+  bool transitioning = false;
+  views::NativeViewHost* host = nullptr;  // BrowserView owns this child.
+  std::unique_ptr<SlotAdapter> adapter;
+  std::unique_ptr<SlotTabObserver> tab_observer;
+  id __strong will_enter;
+  id __strong will_exit;
+  id __strong did_enter;
+  id __strong did_exit;
+  id __strong did_end_sheet;
+};
+auto& Slots() {
+  static base::NoDestructor<std::map<BrowserView*, SlotState>> slots;
+  return *slots;
+}
+bool SlotEnabled() {
+  auto* command = base::CommandLine::ForCurrentProcess();
+  return command && command->HasSwitch("bato-native-slot") &&
+         command->HasSwitch("bato-native-reservation");
+}
+bool SlotBlocked(BrowserView* view) {
+  if (!view->GetWidget() || NSApp.modalWindow ||
+      view->GetWidget()->GetNativeWindow().GetNativeNSWindow().attachedSheet) {
+    return true;
+  }
+  auto* contents = view->GetActiveWebContents();
+  auto* tab = contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  if (tab && tab->IsBlocked()) return true;
+  auto* manager = contents ? web_modal::WebContentsModalDialogManager::FromWebContents(contents) : nullptr;
+  return manager && manager->IsDialogActive();
+}
+bool SlotClosing(BrowserView* view) {
+  // Refuse unsupported lifecycle topology rather than creating/reselecting pages
+  // during global Quit, window beforeunload, irreversible delete or close-all.
+  if (browser_shutdown::IsTryingToQuit()) return true;
+  const auto* unload = UnloadController::From(view->browser());
+  return !unload || unload->is_attempting_to_close_browser() ||
+      unload->is_delete_scheduled() || view->browser()->GetTabStripModel()->closing_all();
+}
+void LogSlotRejection(BrowserView* view, const SlotState& state) {
+  // Rejection-only diagnostics: fixed reasons/flags, never browsing data or IDs.
+  auto* widget = view->GetWidget();
+  NSWindow* window = widget && widget->GetNativeWindow()
+      ? widget->GetNativeWindow().GetNativeNSWindow() : nil;
+  auto* contents = view->GetActiveWebContents();
+  auto* tab = contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  auto* manager = contents
+      ? web_modal::WebContentsModalDialogManager::FromWebContents(contents) : nullptr;
+  const bool visible = state.host && state.host->GetVisible();
+  const bool app_modal = NSApp.modalWindow != nil;
+  const bool sheet = window && window.attachedSheet;
+  const bool tab_blocked = tab && tab->IsBlocked();
+  const bool web_dialog = manager && manager->IsDialogActive();
+  const bool closing = SlotClosing(view);
+  const char* reason = !state.host ? "host-missing"
+      : state.transitioning ? "transitioning"
+      : !visible ? "host-hidden"
+      : !widget ? "widget-unavailable"
+      : app_modal ? "application-modal"
+      : sheet ? "attached-sheet"
+      : tab_blocked ? "tab-blocked"
+      : web_dialog ? "web-dialog-active"
+      : closing ? "lifecycle-closing" : "unavailable";
+  fprintf(stderr,
+          "{\"event\":\"native-slot-rejected\",\"reason\":\"%s\","
+          "\"host_visible\":%s,\"transitioning\":%s,\"widget_available\":%s,"
+          "\"app_modal\":%s,\"attached_sheet\":%s,\"tab_blocked\":%s,"
+          "\"web_dialog_active\":%s,\"lifecycle_closing\":%s}\n",
+          reason, visible ? "true" : "false", state.transitioning ? "true" : "false",
+          widget ? "true" : "false", app_modal ? "true" : "false",
+          sheet ? "true" : "false", tab_blocked ? "true" : "false",
+          web_dialog ? "true" : "false", closing ? "true" : "false");
+}
+BrowserView* FindSlot(uint64_t token) {
+  for (const auto& [view, state] : Slots()) {
+    if (state.token == token && state.host && !state.transitioning &&
+        state.host->GetVisible() && !SlotBlocked(view) && !SlotClosing(view)) return view;
+    if (state.token == token) LogSlotRejection(view, state);
+  }
+  return nullptr;
+}
+void NotifyActivePage(uint64_t token, content::WebContents* contents) {
+  // Never publish automatic close-all/Quit selection into saved organization.
+  for (const auto& [view, state] : Slots()) {
+    if (state.token != token || !state.adapter || SlotClosing(view)) continue;
+    const auto callbacks = g_page_callbacks;
+    if (!callbacks.active_changed) return;
+    auto browser = contents ? ChromeBrowserHostImpl::GetBrowserForContents(contents) : nullptr;
+    const int identifier = browser ? browser->GetIdentifier() : 0;
+    if (identifier <= 0) return;  // Skip transient insertion/no-active host states.
+    // Client posts this notification before making any tab-strip mutations.
+    callbacks.active_changed(callbacks.context, token, identifier);
+    return;  // No access to SlotState after potentially reentrant client code.
+  }
+}
+CefRefPtr<ChromeBrowserHostImpl> BrowserInSlot(BrowserView* view, int identifier) {
+  auto* tabs = view->browser()->GetTabStripModel();
+  for (int index = 0; index < tabs->count(); ++index) {
+    auto browser = ChromeBrowserHostImpl::GetBrowserForContents(tabs->GetWebContentsAt(index));
+    if (browser && browser->GetIdentifier() == identifier) return browser;
+  }
+  return nullptr;
+}
