+// WebContents owns the observer, so its destruction cannot leave a dangling
+// observer map. One observer is installed for each explicit close request.
+const char kPageCloseObserverKey[] = "bato-native-slot-close-observer";
+class PageCloseObserver final : public base::SupportsUserData::Data,
+                                public content::WebContentsObserver {
+ public:
+  PageCloseObserver(content::WebContents* contents, uint64_t token, int browser_id)
+      : content::WebContentsObserver(contents), token_(token), browser_id_(browser_id) {}
+  void BeforeUnloadFired(bool proceed) override {
+    if (!proceed) Cancelled();
+  }
+  void BeforeUnloadDialogCancelled() override { Cancelled(); }
+ private:
+  void Cancelled() {
+    if (!pending_) return;
+    pending_ = false;  // Disarm before a callback that can synchronously re-enter.
+    // Modal state can still be clearing here; do not use FindSlot's input guard.
+    bool attached = false;
+    for (const auto& [view, state] : Slots()) {
+      if (state.token == token_ && state.adapter) { attached = true; break; }
+    }
+    const auto callbacks = g_page_callbacks;
+    if (attached && callbacks.close_cancelled) {
+      // No access to this object after invoking client code, which can destroy it.
+      callbacks.close_cancelled(callbacks.context, token_, browser_id_);
+    }
+  }
+  const uint64_t token_;
+  const int browser_id_;
+  bool pending_ = true;
+};
+
+void ObserveWindowNotifications(BrowserView* view, SlotState& state) {
+  NSWindow* window = view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  auto change = ^(NSNotification* note) {
+    auto found = Slots().find(view);
+    if (found == Slots().end()) return;
+    auto& current = found->second;
+    current.transitioning =
+        [note.name isEqualToString:NSWindowWillEnterFullScreenNotification] ||
+        [note.name isEqualToString:NSWindowWillExitFullScreenNotification];
+    current.fullscreen_reveal = false;
+    if (current.host) current.host->SetVisible(false);
+    EndPeek(view, MultiContentsView::PeekEndReason::kFullscreen);
+    // Client code can tear the slot down; re-find before touching it again.
+    found = Slots().find(view);
+    if (found == Slots().end()) return;
+    // Recalculate authoritative geometry after the transition completes.
+    if (!current.transitioning) view->InvalidateLayout();
+  };
+  state.will_enter = [center addObserverForName:NSWindowWillEnterFullScreenNotification object:window queue:nil usingBlock:change];
+  state.will_exit = [center addObserverForName:NSWindowWillExitFullScreenNotification object:window queue:nil usingBlock:change];
+  state.did_enter = [center addObserverForName:NSWindowDidEnterFullScreenNotification object:window queue:nil usingBlock:change];
+  state.did_exit = [center addObserverForName:NSWindowDidExitFullScreenNotification object:window queue:nil usingBlock:change];
+  const uint64_t token = state.token;
+  // A window sheet covers the backdrop as well as the preview; end rather than
+  // present under it. Tab-modal dialogs (e.g. beforeunload of the preview) keep it.
+  state.will_begin_sheet = [center addObserverForName:NSWindowWillBeginSheetNotification
+      object:window queue:nil usingBlock:^(NSNotification*) {
+    auto found = Slots().find(view);
+    if (found != Slots().end() && found->second.token == token)
+      EndPeek(view, MultiContentsView::PeekEndReason::kModal);
+  }];
+  state.did_end_sheet = [center addObserverForName:NSWindowDidEndSheetNotification
+      object:window queue:nil usingBlock:^(NSNotification* note) {
+    auto found = Slots().find(view);
+    if (found == Slots().end() || found->second.token != token || SlotClosing(view)) return;
+    const bool was_visible = found->second.host && found->second.host->GetVisible();
+    NSWindow* parent = note.object;
+    const bool sheet = parent.attachedSheet != nil;
+    // AppKit sheet dismissal need not trigger Views layout. Reconcile existing
+    // bounds/visibility through the normal modal/fullscreen guards now that the
+    // authoritative sheet state changed; do not bypass FindSlot or retry later.
+    cef::NativeSlotUpdate(view, false, false);
+    // Native layout may re-enter client code and tear down or replace the slot.
+    auto current = Slots().find(view);
+    if (current == Slots().end() || current->second.token != token) return;
+    const bool visible = current->second.host && current->second.host->GetVisible();
+    fprintf(stderr,
+            "{\"event\":\"native-slot-sheet-ended\",\"attached_sheet\":%s,"
+            "\"host_visible_before\":%s,\"host_visible_after\":%s}\n",
+            sheet ? "true" : "false", was_visible ? "true" : "false",
+            visible ? "true" : "false");
+  }];
+}
+}
