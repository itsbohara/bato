+// Built-in blocking. The Rust engine is loaded with dlopen so the GN build needs no Rust
+// inputs. It runs when a blocking root is known (--bato-blocking-dir, else
+// <--bato-workspace-state>/blocking); --bato-no-blocking turns it off. The root holds the
+// filter lists shared by every Profile (lists/*.txt) and one settings directory per Profile
+// (<root>/<ProfileKey>/blocking-settings.json), all written atomically by the Swift side.
+// Each request resolves its browser to a Profile key, so a Profile's enabled flag and
+// exceptions never apply to another Profile. A background task polls file stamps and builds
+// engines off the IO thread, one per distinct list set (every Profile uses the shared one
+// today); requests are allowed until a Profile's settings and its engine are ready. Engines
+// are immutable and shared_ptr-held, so a replaced engine stays alive for checks already
+// running on the IO thread.
+typedef void* (*BlockingCreate)(const char*);
+typedef int (*BlockingCheck)(const void*, const char*, const char*, const char*);
+typedef void (*BlockingFree)(void*);
+typedef int (*BlockingStart)(const char*);
+typedef void (*BlockingBrowserHook)(int);
+
+struct BlockingEngine {
+  BlockingEngine(void* engine, BlockingCheck check, BlockingFree release)
+      : engine(engine), check(check), release(release) {}
+  ~BlockingEngine() { release(engine); }
+  void* const engine;
+  const BlockingCheck check;
+  const BlockingFree release;
+};
+
+struct BlockingSettings {
+  bool enabled = true;
+  std::vector<std::string> exceptions;
+};
+
+// A directory of lists and the engine built from it. An empty directory means only the
+// --bato-blocking list.
+struct ListSet {
+  explicit ListSet(std::string directory) : directory(std::move(directory)) {}
+  const std::string directory;
+  // Touched only by the background refresh task.
+  std::string stamp;
+  // Guarded by BlockingState::mutex.
+  std::shared_ptr<const BlockingEngine> engine;
+};
+
+struct ProfileBlocking {
+  ProfileBlocking(std::string directory, std::shared_ptr<ListSet> lists)
+      : directory(std::move(directory)), lists(std::move(lists)) {}
+  // Empty without a blocking root: the default settings then apply.
+  const std::string directory;
+  const std::shared_ptr<ListSet> lists;
+  // Guarded by BlockingState::mutex. Null until the file is first read, which fails open.
+  std::shared_ptr<const BlockingSettings> settings;
+  // Touched only by the background refresh task.
+  bool settings_read = false;
+  std::string settings_stamp;
+};
+
+struct BlockingState {
+  std::string root;
+  std::string extra_list;
+  bool log_blocked = false;
+  BlockingCreate create = nullptr;
+  BlockingCheck check = nullptr;
+  BlockingFree release = nullptr;
+  BlockingBrowserHook page_started = nullptr;
+  BlockingBrowserHook blocked = nullptr;
+  std::mutex mutex;
+  std::map<std::string, std::shared_ptr<ListSet>> list_sets;
+  std::map<std::string, std::shared_ptr<ProfileBlocking>> profiles;
+};
+
+// Intentionally leaked: handlers and the refresh task outlive static destruction.
+BlockingState* g_blocking = nullptr;
+// Posting after the message loop exits crashes CEF, so the poll must stop first.
+std::atomic<bool> g_blocking_stopping{false};
+const int64_t kBlockingPollMs = 250;
+
+std::string JsonEscape(const std::string& text) {
+  std::string out;
+  for (unsigned char c : text) {
+    if (c == '"' || c == '\\') {
+      out += '\\';
+      out += static_cast<char>(c);
+    } else if (c < 0x20) {
+      char buffer[8];
+      snprintf(buffer, sizeof(buffer), "\\u%04x", c);
+      out += buffer;
+    } else {
+      out += static_cast<char>(c);
+    }
+  }
+  return out;
+}
+
+void LogBlockingEvent(const char* event, const std::string& url,
+                      const char* type) {
+  fprintf(stderr, "{\"bato\":\"blocking\",\"event\":\"%s\",\"url\":\"%s\","
+                  "\"type\":\"%s\"}\n",
+          event, JsonEscape(url).c_str(), type);
+}
+
+const char* BlockingRequestType(cef_resource_type_t type) {
+  switch (type) {
+    case RT_SUB_FRAME:
+      return "subdocument";
+    case RT_STYLESHEET:
+      return "stylesheet";
+    case RT_SCRIPT:
+    case RT_WORKER:
+    case RT_SHARED_WORKER:
+    case RT_SERVICE_WORKER:
+      return "script";
+    case RT_IMAGE:
+    case RT_FAVICON:
+      return "image";
+    case RT_FONT_RESOURCE:
+      return "font";
+    case RT_MEDIA:
+      return "media";
+    case RT_XHR:
+      return "xmlhttprequest";
+    case RT_PING:
+      return "ping";
+    default:
+      return "other";
+  }
+}
+
+std::string FileStamp(const std::string& path) {
+  struct stat info;
+  if (stat(path.c_str(), &info) != 0) {
+    return "";
+  }
+  return std::to_string(info.st_size) + ":" +
+         std::to_string(info.st_mtimespec.tv_sec) + "." +
+         std::to_string(info.st_mtimespec.tv_nsec);
+}
+
+bool ReadFile(const std::string& path, std::string* out) {
+  std::ifstream file(path, std::ios::binary);
+  if (!file) {
+    return false;
+  }
+  std::stringstream text;
+  text << file.rdbuf();
+  *out = text.str();
+  return true;
+}
+
+std::vector<std::string> ListFiles(const std::string& directory) {
+  std::vector<std::string> names;
+  DIR* dir = opendir(directory.c_str());
+  if (!dir) {
+    return names;
+  }
+  while (dirent* entry = readdir(dir)) {
+    const std::string name = entry->d_name;
+    if (name.size() > 4 && name[0] != '.' &&
+        name.compare(name.size() - 4, 4, ".txt") == 0) {
+      names.push_back(name);
+    }
+  }
+  closedir(dir);
+  std::sort(names.begin(), names.end());
+  return names;
+}
+
+std::string LowerHost(std::string host) {
+  std::transform(host.begin(), host.end(), host.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  while (!host.empty() && host.back() == '.') {
+    host.pop_back();
+  }
+  return host;
+}
+
+std::string HostOfUrl(const std::string& url) {
+  // CefParseURL aborts the process on an empty string.
+  if (url.empty()) {
+    return "";
+  }
+  CefURLParts parts;
+  if (!CefParseURL(url, parts)) {
+    return "";
+  }
+  return LowerHost(CefString(&parts.host).ToString());
+}
