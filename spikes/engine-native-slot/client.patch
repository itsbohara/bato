+public enum BrowserStateError: Error, Equatable, LocalizedError {
+    case unsupportedVersion(Int)
+    case emptyName
+    case invalidURL
+    case invalidColor
+    case duplicateIdentity
+    case missingProfile
+    case missingWorkspace
+    case invalidEntryOwnership
+    case invalidSavedURL
+    case missingEntry
+    case invalidSelection
