+                                     page_host);
+}
+
+namespace {
+// UI thread. The engine to use for cosmetic rules on this browser's page, or null: blocking is off for
+// the Profile or for the top-level page's site (the same enabled flag and exceptions as requests), the
+// Profile is unknown, or the library has no cosmetic support.
+std::shared_ptr<const BlockingEngine> CosmeticEngineFor(CefRefPtr<CefBrowser> browser) {
+  if (!g_blocking || !g_blocking->cosmetic_script || !g_blocking->cosmetic_generic ||
+      !g_blocking->cosmetic_free || !browser) {
+    return nullptr;
+  }
+  const std::string key = BatoWorkspaceBlockingProfileKey(browser->GetIdentifier());
+  if (!ValidBlockingProfileKey(key)) {
+    return nullptr;
+  }
+  CefRefPtr<CefFrame> main_frame = browser->GetMainFrame();
+  const std::string page_host = HostOfUrl(main_frame ? main_frame->GetURL().ToString() : "");
+  auto profile = BlockingProfileFor(key);
+  std::lock_guard<std::mutex> lock(g_blocking->mutex);
+  if (!profile->lists->engine || !profile->settings || !profile->settings->enabled ||
+      HostHasException(*profile->settings, page_host)) {
+    return nullptr;
+  }
+  return profile->lists->engine;
+}
+
+bool IsWebUrl(const std::string& url) {
+  return url.rfind("http://", 0) == 0 || url.rfind("https://", 0) == 0;
+}
+}  // namespace
+
+void SimpleHandler::OnLoadStart(CefRefPtr<CefBrowser> browser,
+                                CefRefPtr<CefFrame> frame,
+                                TransitionType transition_type) {
+  CEF_REQUIRE_UI_THREAD();
+  const std::string url = frame ? frame->GetURL().ToString() : "";
+  if (!IsWebUrl(url)) {
+    return;
+  }
+  auto engine = CosmeticEngineFor(browser);
+  if (!engine) {
+    return;
+  }
+  char* script = g_blocking->cosmetic_script(engine->engine, url.c_str());
+  if (!script) {
+    return;
+  }
+  frame->ExecuteJavaScript(script, url, 0);
+  g_blocking->cosmetic_free(script);
+}
+
+namespace {
+// A page's class and id names arrive from the injected harvester, by console line and by a request to the
+// reserved host below. The reply is computed from engine data only, never from the report, and a report
+// already handled for this browser is ignored.
+void ApplyGenericCosmetics(CefRefPtr<CefBrowser> browser, const std::string& names) {
+  static std::map<int, std::string>* handled = new std::map<int, std::string>;
+  CefRefPtr<CefFrame> main_frame = browser ? browser->GetMainFrame() : nullptr;
+  const std::string url = main_frame ? main_frame->GetURL().ToString() : "";
+  auto engine = IsWebUrl(url) ? CosmeticEngineFor(browser) : nullptr;
+  if (!engine || names.empty() || (*handled)[browser->GetIdentifier()] == names) {
+    return;
+  }
+  (*handled)[browser->GetIdentifier()] = names;
+  char* script = g_blocking->cosmetic_generic(engine->engine, url.c_str(), names.c_str());
+  if (g_blocking->log_blocked) {
+    fprintf(stderr, "{\"bato\":\"cosmetic\",\"event\":\"generic\",\"bytes\":%zu,\"rules\":%s}\n",
+            names.size(), script ? "true" : "false");
+  }
+  if (script) {
+    main_frame->ExecuteJavaScript(script, url, 0);
+    g_blocking->cosmetic_free(script);
+  }
+}
+
+void AppendNames(CefRefPtr<CefListValue> list, const char* tag, std::string* names) {
+  for (size_t i = 0; list && i < list->GetSize(); ++i) {
+    const std::string name = list->GetType(i) == VTYPE_STRING ? list->GetString(i).ToString() : "";
+    if (!name.empty() && name.find_first_of("\n\r") == std::string::npos) {
+      *names += std::string(tag) + name + "\n";
+    }
+  }
+}
+
+void HandleCosmeticReport(int browser_id, std::string query) {
+  CEF_REQUIRE_UI_THREAD();
+  CefRefPtr<CefBrowser> browser = CefBrowserHost::GetBrowserByIdentifier(browser_id);
+  if (!browser || query.size() > 200000) {
+    return;
+  }
+  std::string names;
+  size_t start = 0;
+  while (start <= query.size()) {
+    size_t end = query.find('&', start);
+    if (end == std::string::npos) end = query.size();
+    const std::string part = query.substr(start, end - start);
+    const char* tag = part.rfind("c=", 0) == 0 ? "c:" : part.rfind("i=", 0) == 0 ? "i:" : nullptr;
+    if (tag) {
+      size_t item = 2;
+      while (item <= part.size()) {
+        size_t stop = part.find(',', item);
+        if (stop == std::string::npos) stop = part.size();
+        // CefURIDecode aborts the process on an empty string; an empty list is a normal report.
+        const std::string name =
+            stop > item ? CefURIDecode(part.substr(item, stop - item), false, UU_NORMAL).ToString() : "";
+        if (!name.empty() && name.find_first_of("\n\r") == std::string::npos) {
+          names += std::string(tag) + name + "\n";
+        }
+        item = stop + 1;
+      }
+    }
+    start = end + 1;
+  }
+  ApplyGenericCosmetics(browser, names);
+}
+
+}  // namespace
+
+bool SimpleHandler::OnConsoleMessage(CefRefPtr<CefBrowser> browser,
+                                     cef_log_severity_t level,
+                                     const CefString& message,
+                                     const CefString& source,
+                                     int line) {
+  CEF_REQUIRE_UI_THREAD();
+  static const char kPrefix[] = "bato-cosmetic:";
+  const std::string text = message.ToString();
+  if (text.rfind(kPrefix, 0) != 0) {
+    return false;
+  }
+  CefRefPtr<CefValue> root = CefParseJSON(text.substr(sizeof(kPrefix) - 1), JSON_PARSER_RFC);
+  if (browser && root && root->GetType() == VTYPE_DICTIONARY) {
+    std::string names;
+    CefRefPtr<CefDictionaryValue> dict = root->GetDictionary();
+    AppendNames(dict->GetList("c"), "c:", &names);
+    AppendNames(dict->GetList("i"), "i:", &names);
+    ApplyGenericCosmetics(browser, names);
+  }
+  return true;
 }

