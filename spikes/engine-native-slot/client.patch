+        }
+        moveDown.isEnabled = runtime.state.canMoveWorkspace(id, direction: .down)
+        menu.addItem(moveDown)
+        menu.popUp(positioning: nil, at: NSPoint(x: 0, y: workspaceActions.bounds.minY), in: workspaceActions)
