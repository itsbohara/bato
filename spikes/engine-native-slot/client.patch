+
+    /// Closes the current Workspace's temporary tabs other than the selection. Saved pages stay.
+    @discardableResult
+    public func closeOtherTemporaryTabs() -> Bool {
+        closeTemporaryTabs { entries, selected in entries.filter { $0.id != selected } }
