+    public static func isExternalWebLink(_ url: URL) -> Bool {
+        guard let scheme = url.scheme?.lowercased(), ["http", "https"].contains(scheme) else { return false }
+        return url.host?.isEmpty == false && url.user == nil && url.password == nil
+    }
