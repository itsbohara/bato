+/// What the Settings window needs from the workspace. Every action runs against the current
+/// organization at the moment it is invoked, never against a snapshot held by the window.
+struct SettingsHooks {
+    let state: () -> BrowserState
+    let blockingService: (String) -> BlockingService?
+    let createProfile: () -> Void
+    let deleteProfile: (UUID) -> Void
+    let renameCurrentProfile: () -> Void
+    let importFromArc: () -> Void
+    let openEssential: (BrowserEssential) -> Void
+    let defaultBrowser: DefaultBrowser
+    let recovery: RecoveryController
+    let setArchivePeriod: (ArchivePeriod) -> Void
+    let setWorkspaceArchivePeriod: (UUID, ArchivePeriod?) -> Void
+    let openArchive: () -> Void
+    let searchProvider: () -> CommandBarSearchProvider
+    let setSearchProvider: (CommandBarSearchProvider) -> Void
+    let searchSuggestions: () -> Bool
+    let setSearchSuggestions: (Bool) -> Void
+    let tabLayout: () -> TabLayout
+    let setTabLayout: (TabLayout) -> Void
+}
+
+extension DefaultBrowser {
+    /// Bato as the running application, checked against what Launch Services hands web links to.
+    static func system(appURL: URL = Bundle.main.bundleURL) -> DefaultBrowser {
+        DefaultBrowser(appURL: appURL, handler: { scheme in
+            URL(string: "\(scheme)://example.com").flatMap { NSWorkspace.shared.urlForApplication(toOpen: $0) }
+        }, assign: { scheme in
+            try await NSWorkspace.shared.setDefaultApplication(at: appURL, toOpenURLsWithScheme: scheme)
+        })
+    }
+}
+
+/// Bato's own preferences, in a standalone window. Chromium's settings stay in their web page.
+@MainActor
+final class SettingsWindowController: NSObject, NSWindowDelegate {
+    private let hooks: SettingsHooks
+    private let window: NSWindow
+    private let sidebarStack = NSStackView()
+    private let contentHost = NSView()
+    private var sidebarButtons: [SettingsPane: SettingsSidebarButton] = [:]
+    private(set) var pane: SettingsPane = .profiles
+    private var history: [SettingsPane] = [.profiles]
+    private var historyIndex = 0
+    private let backButton = NSButton()
+    private let forwardButton = NSButton()
+    private let titleLabel = NSTextField(labelWithString: "")
+
+    init(hooks: SettingsHooks) {
+        self.hooks = hooks
+        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 960, height: 700),
+                          styleMask: [.titled, .closable, .miniaturizable, .fullSizeContentView],
+                          backing: .buffered, defer: false)
+        super.init()
+        window.title = "Settings"
+        window.titlebarAppearsTransparent = true
+        window.isReleasedWhenClosed = false
+        window.delegate = self
+        window.setFrameAutosaveName("BatoSettings")
+        buildLayout()
+    }
+
+    func show(_ pane: SettingsPane? = nil) {
+        if let pane { navigate(to: pane) }
+        reload()
+        if !window.isVisible { window.center() }
+        window.makeKeyAndOrderFront(nil)
+    }
+
+    private func navigate(to target: SettingsPane) {
+        guard target != pane else { return }
+        history = Array(history.prefix(historyIndex + 1)) + [target]
+        historyIndex = history.count - 1
+        pane = target
+    }
+
+    @objc private func goBack() { step(-1) }
+    @objc private func goForward() { step(1) }
+
+    private func step(_ delta: Int) {
+        let next = historyIndex + delta
+        guard history.indices.contains(next) else { return }
+        historyIndex = next
+        pane = history[next]
+        reload()
+    }
+
+    /// Rebuilds the visible pane from current organization, e.g. after a Profile was created.
+    func reload() {
+        for (candidate, button) in sidebarButtons { button.isSelected = candidate == pane }
+        titleLabel.stringValue = pane.title
+        backButton.isEnabled = historyIndex > 0
+        forwardButton.isEnabled = historyIndex < history.count - 1
+        contentHost.subviews.forEach { $0.removeFromSuperview() }
+        let scroll = NSScrollView()
+        scroll.drawsBackground = false
+        scroll.hasVerticalScroller = true
+        scroll.autohidesScrollers = true
+        // Legacy scrollers take 16 pt from the clip view, narrowing cards on long panes only.
+        scroll.scrollerStyle = .overlay
+        scroll.translatesAutoresizingMaskIntoConstraints = false
+        let document = FlippedView()
+        document.translatesAutoresizingMaskIntoConstraints = false
+        let column = NSStackView(views: content(for: pane))
+        column.orientation = .vertical
+        column.alignment = .leading
+        column.spacing = 20
+        column.translatesAutoresizingMaskIntoConstraints = false
+        document.addSubview(column)
+        scroll.documentView = document
+        contentHost.addSubview(scroll)
+        NSLayoutConstraint.activate([
+            scroll.topAnchor.constraint(equalTo: contentHost.topAnchor),
+            scroll.bottomAnchor.constraint(equalTo: contentHost.bottomAnchor),
+            scroll.leadingAnchor.constraint(equalTo: contentHost.leadingAnchor),
+            scroll.trailingAnchor.constraint(equalTo: contentHost.trailingAnchor),
+            document.widthAnchor.constraint(equalTo: scroll.contentView.widthAnchor),
+            column.topAnchor.constraint(equalTo: document.topAnchor, constant: 76),
+            column.leadingAnchor.constraint(equalTo: document.leadingAnchor, constant: 40),
+            column.trailingAnchor.constraint(equalTo: document.trailingAnchor, constant: -40),
+            column.bottomAnchor.constraint(equalTo: document.bottomAnchor, constant: -28),
+        ])
+        for view in column.arrangedSubviews { view.widthAnchor.constraint(equalTo: column.widthAnchor).isActive = true }
+    }
+
+    // MARK: Layout
+
+    private func buildLayout() {
+        let rail = NSVisualEffectView()
+        rail.material = .sidebar
+        rail.blendingMode = .behindWindow
+        rail.state = .followsWindowActiveState
+        rail.translatesAutoresizingMaskIntoConstraints = false
+        sidebarStack.orientation = .vertical
+        sidebarStack.alignment = .leading
+        sidebarStack.spacing = 4
+        sidebarStack.translatesAutoresizingMaskIntoConstraints = false
+        for candidate in SettingsPane.allCases {
+            let button = SettingsSidebarButton(title: candidate.title, symbol: candidate.symbolName) { [weak self] in
+                self?.navigate(to: candidate)
+                self?.reload()
+            }
+            sidebarButtons[candidate] = button
+            sidebarStack.addArrangedSubview(button)
+            button.widthAnchor.constraint(equalTo: sidebarStack.widthAnchor).isActive = true
+        }
+        rail.addSubview(sidebarStack)
+        contentHost.translatesAutoresizingMaskIntoConstraints = false
+        let bar = titleBar()
+        let root = NSView()
+        root.addSubview(rail)
+        root.addSubview(contentHost)
+        root.addSubview(bar)
+        window.contentView = root
+        NSLayoutConstraint.activate([
+            rail.topAnchor.constraint(equalTo: root.topAnchor),
+            rail.bottomAnchor.constraint(equalTo: root.bottomAnchor),
+            rail.leadingAnchor.constraint(equalTo: root.leadingAnchor),
+            rail.widthAnchor.constraint(equalToConstant: 270),
+            sidebarStack.topAnchor.constraint(equalTo: rail.topAnchor, constant: 60),
+            sidebarStack.leadingAnchor.constraint(equalTo: rail.leadingAnchor, constant: 14),
+            sidebarStack.trailingAnchor.constraint(equalTo: rail.trailingAnchor, constant: -14),
+            contentHost.topAnchor.constraint(equalTo: root.topAnchor),
+            contentHost.bottomAnchor.constraint(equalTo: root.bottomAnchor),
+            contentHost.leadingAnchor.constraint(equalTo: rail.trailingAnchor),
+            contentHost.trailingAnchor.constraint(equalTo: root.trailingAnchor),
+            bar.topAnchor.constraint(equalTo: root.topAnchor, constant: 14),
+            bar.leadingAnchor.constraint(equalTo: rail.trailingAnchor, constant: 20),
+        ])
+    }
+
+    /// Back/forward through visited panes plus the pane title, in the title bar row as in Dia.
+    private func titleBar() -> NSView {
+        func configure(_ button: NSButton, symbol: String, label: String, id: String, action: Selector) {
+            button.image = NSImage(systemSymbolName: symbol, accessibilityDescription: label)
+            button.isBordered = false
+            button.imagePosition = .imageOnly
+            button.target = self
+            button.action = action
+            button.setAccessibilityLabel(label)
+            button.setAccessibilityIdentifier(id)
+            button.widthAnchor.constraint(equalToConstant: 30).isActive = true
+            button.heightAnchor.constraint(equalToConstant: 28).isActive = true
+        }
+        configure(backButton, symbol: "chevron.left", label: "Back", id: "bato-settings-back", action: #selector(goBack))
+        configure(forwardButton, symbol: "chevron.right", label: "Forward", id: "bato-settings-forward", action: #selector(goForward))
+        let pair = SettingsNavigationPill(views: [backButton, forwardButton])
+        titleLabel.font = .systemFont(ofSize: 17, weight: .semibold)
+        titleLabel.setAccessibilityIdentifier("bato-settings-title")
+        let bar = NSStackView(views: [pair, titleLabel])
+        bar.orientation = .horizontal
+        bar.spacing = 12
+        bar.alignment = .centerY
+        bar.translatesAutoresizingMaskIntoConstraints = false
+        return bar
+    }
+
+    private func content(for pane: SettingsPane) -> [NSView] {
+        switch pane {
+        case .general: generalPane()
+        case .profiles: profilesPane()
+        case .privacy: privacyPane()
+        case .archive: archivePane()
+        case .importData: importPane()
+        case .shortcuts: shortcutsPane()
+        case .advanced: advancedPane()
+        case .about: aboutPane()
+        }
+    }
+
+    // MARK: Panes
+
+    private func generalPane() -> [NSView] {
+        let picker = SearchProviderPicker(selected: hooks.searchProvider()) { [weak self] in self?.hooks.setSearchProvider($0) }
+        let row = SettingsRow(leading: SymbolTile(symbol: "magnifyingglass", color: .systemBlue),
+                              title: "Search engine",
+                              detail: "Used when you type a search in the command bar. Chromium’s own search engine setting is separate.",
+                              trailing: picker)
+        let layoutPicker = TabLayoutPicker(selected: hooks.tabLayout()) { [weak self] in self?.hooks.setTabLayout($0) }
+        let layoutRow = SettingsRow(leading: SymbolTile(symbol: "sidebar.left", color: .systemPurple),
+                                    title: "Tab location",
+                                    detail: "Keep tabs in a sidebar on either side, or in a strip above the page.",
+                                    trailing: layoutPicker)
+        return [sectionHeading("Search"), SettingsGroup(rows: [row]),
+                sectionHeading("Tabs"), SettingsGroup(rows: [layoutRow])]
+    }
+
+    private func aboutPane() -> [NSView] {
+        let info = AboutInfo(
+            bundleVersion: Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String,
+            bundleBuild: Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String,
+            versionFileText: Bundle.main.url(forResource: "VERSION", withExtension: nil).flatMap { try? String(contentsOf: $0, encoding: .utf8) })
+        let version = SettingsRow(leading: SymbolTile(symbol: "info.circle.fill", color: .systemTeal),
+                                  title: "Bato", detail: "Version \(info.displayVersion). Released under the MIT License.", trailing: nil)
+        let notices = SettingsRow(leading: nil, title: "Open source notices",
+                                  detail: "Chromium, the Chromium Embedded Framework, adblock-rust and the filter lists Bato can download.",
+                                  trailing: SettingsPillButton(title: "View Notices") {
+                                      NSWorkspace.shared.open(Bundle.main.url(forResource: "NOTICES", withExtension: "md") ?? AboutInfo.noticesURL)
+                                  })
+        return [SettingsGroup(rows: [version, notices])]
+    }
+
+    private func profilesPane() -> [NSView] {
+        let note = caption("Each Profile keeps its own history, downloads, logins, cookies and extensions.")
+        let rows = SettingsProfileRow.rows(from: hooks.state()).map { row -> NSView in
+            var actions: [NSView] = []
+            if row.isCurrent {
+                actions.append(SettingsPillButton(title: "Rename…") { [weak self] in self?.hooks.renameCurrentProfile() })
+            }
+            if row.id != hooks.state().launchProfileID {
+                let delete = SettingsPillButton(title: "Delete…") { [weak self] in self?.hooks.deleteProfile(row.id) }
+                delete.setAccessibilityIdentifier("bato-profile-delete")
+                actions.append(delete)
+            }
+            let action: NSView? = actions.isEmpty ? nil : actions.count == 1 ? actions[0] : NSStackView(views: actions)
+            return SettingsRow(leading: ColorDot(hex: row.colorHex), title: row.name, detail: row.detail, trailing: action)
+        }
+        let create = SettingsPillButton(title: "Create Profile…") { [weak self] in self?.hooks.createProfile() }
+        return [note, SettingsGroup(rows: rows), trailingAligned(create)]
+    }
+
+    private func searchSuggestionsGroup() -> [NSView] {
+        let toggle = NSSwitch()
+        toggle.state = hooks.searchSuggestions() ? .on : .off
+        let handler = ActionTarget { [weak self, weak toggle] in
+            guard let toggle else { return }
+            self?.hooks.setSearchSuggestions(toggle.state == .on)
+        }
+        toggle.target = handler
+        toggle.action = #selector(ActionTarget.fire)
+        toggle.setAccessibilityLabel("Search suggestions")
+        toggle.setAccessibilityIdentifier("bato-search-suggestions")
+        let row = SettingsRow(leading: SymbolTile(symbol: "text.magnifyingglass", color: .systemBlue),
+                              title: "Search suggestions",
+                              detail: "Sends what you type in the command bar to your search engine to suggest searches. Addresses are never sent.",
+                              trailing: toggle, keeping: handler)
+        return [sectionHeading("Command bar"), SettingsGroup(rows: [row])]
+    }
+
+    private func privacyPane() -> [NSView] {
+        let state = hooks.state()
+        guard let profile = state.profiles.first(where: { $0.id == state.currentWorkspace.profileID }),
+              let service = hooks.blockingService(profile.id.uuidString) else {
+            return searchSuggestionsGroup() + [caption("Content blocking starts with the browser engine and isn’t available yet."),
+                    sectionHeading("Site permissions"), sitePermissionsGroup(detail: "Camera, location, notifications and more, per site.")]
+        }
+        let toggle = NSSwitch()
+        toggle.state = service.settings.enabled ? .on : .off
+        let handler = ActionTarget { [weak self, weak toggle] in
+            guard let toggle else { return }
+            if (try? service.setEnabled(toggle.state == .on)) == nil { toggle.state = toggle.state == .on ? .off : .on }
+            self?.reload()
+        }
+        toggle.target = handler
+        toggle.action = #selector(ActionTarget.fire)
+        toggle.setAccessibilityLabel("Block ads and trackers")
+        let blocking = SettingsRow(leading: SymbolTile(symbol: "hand.raised.fill", color: .systemRed),
+                                   title: "Block ads and trackers", detail: "For the \(profile.name) Profile",
+                                   trailing: toggle, keeping: handler)
+        var views = searchSuggestionsGroup()
+        views += [sectionHeading("Content blocking"), SettingsGroup(rows: [blocking, uBlockListsRow()])]
+        views += sitePermissions(forProfile: profile.name)
+        let exceptions = service.exceptions
+        views.append(exceptions.isEmpty ? caption("No sites are excluded from blocking.") : sectionHeading("Sites excluded from blocking"))
+        if !exceptions.isEmpty {
+            views.append(SettingsGroup(rows: exceptions.map { host in
+                SettingsRow(leading: nil, title: host, detail: nil, trailing: SettingsPillButton(title: "Remove") { [weak self] in
+                    try? service.removeException(host: host)
+                    self?.reload()
+                })
+            }))
+        }
+        return views
