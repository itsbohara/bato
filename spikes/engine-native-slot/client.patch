+    }
+
+    private static func entriesBelow(_ entries: [PageEntry], _ selected: UUID) -> [PageEntry] {
+        guard let index = entries.firstIndex(where: { $0.id == selected }) else { return [] }
+        return Array(entries[(index + 1)...])
