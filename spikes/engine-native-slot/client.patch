+    g_swift_download_upserted(key.c_str(), copy.id.c_str(), copy.filename.c_str(), copy.path.c_str(),
+                              copy.received, copy.total, copy.bytes_per_second, copy.state,
+                              copy.can_resume, copy.file_exists, copy.warning);
