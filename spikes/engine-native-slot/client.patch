+@MainActor
+private final class PageSearchTable: NSTableView {
+    var openSelection: (() -> Void)?
+    var cancel: (() -> Void)?
+
+    override func keyDown(with event: NSEvent) {
+        switch event.keyCode {
+        case 36, 76: openSelection?()
+        case 53: cancel?()
+        default: super.keyDown(with: event)
+        }
