+        let dimmed = SplitPaneControls.dimmed(focused: state.isFocused)
+        let toggles: [(NSView, SplitPaneControls)] = [(reload, .reload), (splitButton, .splitMenu)]
+        let dimTargets: [(NSButton, SplitPaneControls)] = [(back, .back), (forward, .forward)]
