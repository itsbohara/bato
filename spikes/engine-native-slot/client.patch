+    private func switchWorkspace(_ id: UUID) {
+        guard hasStarted, root.window?.attachedSheet == nil, NSApp.modalWindow == nil,
+              id != runtime.state.activeWorkspaceID else { return }
+        perform { runtime.activateWorkspace(id) }
+    }
