+
+    var isShown: Bool { popover.isShown }
+
+    func show(_ entries: [SwitcherEntry], relativeTo anchor: NSView, edge: NSRectEdge = .maxY) {
+        popover.close()
+        let stack = NSStackView()
+        stack.orientation = .vertical
+        stack.alignment = .leading
+        stack.spacing = 1
