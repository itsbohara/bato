+struct WorkspaceSlot {
+  CefRefPtr<CefBrowser> anchor;
+  CefRefPtr<CefRequestContext> context;
+  std::map<int, BoundPage> pages;
+  std::set<int> pending_close;
+  int split_left = 0;
