+CefRefPtr<CefResourceRequestHandler> SimpleHandler::GetResourceRequestHandler(
+    CefRefPtr<CefBrowser> browser,
+    CefRefPtr<CefFrame> frame,
+    CefRefPtr<CefRequest> request,
+    bool is_navigation,
+    bool is_download,
+    const CefString& request_initiator,
+    bool& disable_default_handling) {
+  if (is_navigation && IsExternalProtocolRequest(request)) {
+    return new ExternalProtocolHandler();
+  }
+  if (!g_blocking) {
+    return nullptr;
+  }
+  if (g_blocking->cosmetic_generic &&
+      request->GetURL().ToString().rfind(kCosmeticReportPrefix, 0) == 0) {
+    return new CosmeticReportHandler();
+  }
+  // Top-level navigations are never filtered: only subresources, subframes
+  // and worker loads are blocked. A new one restarts the page's blocked count.
+  if (request->GetResourceType() == RT_MAIN_FRAME) {
+    if (g_blocking->page_started && browser) {
+      g_blocking->page_started(browser->GetIdentifier());
+    }
+    return nullptr;
+  }
+  std::string source = request_initiator;
+  if (source.empty() && frame) {
+    source = frame->GetURL();
+  }
+  // Exceptions are keyed by the top-level page, not by a subframe's origin.
+  CefRefPtr<CefFrame> main_frame = browser ? browser->GetMainFrame() : nullptr;
+  std::string page_url = main_frame ? main_frame->GetURL().ToString() : "";
+  if (page_url.empty()) {
+    page_url = source;
+  }
+  const std::string page_host = HostOfUrl(page_url);
+  // The browser's Profile selects whose settings apply. An unresolved browser is not filtered.
+  const std::string key =
+      BatoWorkspaceBlockingProfileKey(browser ? browser->GetIdentifier() : 0);
+  if (!ValidBlockingProfileKey(key)) {
+    return nullptr;
+  }
