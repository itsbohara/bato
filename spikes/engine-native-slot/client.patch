+CefRefPtr<CefBrowser> CurrentPeer(uint64_t token, const WorkspaceSlot& slot) {
+  CefRefPtr<CefBrowser> peer = slot.anchor;
+  if (!peer || !peer->IsValid()) {
+    const int identifier = g_active_browser_id(token);
