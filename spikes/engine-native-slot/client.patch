+      stringByAppendingPathComponent:@"Library/Application Support/Bato/Profiles"]
+      .stringByResolvingSymlinksInPath;
+  return [profile isEqualToString:real] || [profile hasPrefix:[real stringByAppendingString:@"/"]];
