+// Returns null unless the document is a version-1 settings object.
+std::shared_ptr<const BlockingSettings> ParseBlockingSettings(
+    const std::string& json) {
+  CefRefPtr<CefValue> root = CefParseJSON(json, JSON_PARSER_RFC);
+  if (!root || root->GetType() != VTYPE_DICTIONARY) {
+    return nullptr;
+  }
+  CefRefPtr<CefDictionaryValue> dict = root->GetDictionary();
+  if (dict->GetType("version") != VTYPE_INT || dict->GetInt("version") != 1 ||
+      dict->GetType("enabled") != VTYPE_BOOL ||
+      dict->GetType("exceptions") != VTYPE_LIST) {
+    return nullptr;
+  }
+  auto settings = std::make_shared<BlockingSettings>();
+  settings->enabled = dict->GetBool("enabled");
+  CefRefPtr<CefListValue> exceptions = dict->GetList("exceptions");
+  for (size_t i = 0; i < exceptions->GetSize(); ++i) {
+    if (exceptions->GetType(i) == VTYPE_STRING) {
+      settings->exceptions.push_back(
+          LowerHost(exceptions->GetString(i).ToString()));
+    }
+  }
+  return settings;
+}
+
+bool HostHasException(const BlockingSettings& settings,
+                      const std::string& host) {
+  for (const std::string& exception : settings.exceptions) {
+    if (host == exception ||
+        (host.size() > exception.size() &&
+         host.compare(host.size() - exception.size(), exception.size(),
+                      exception) == 0 &&
+         host[host.size() - exception.size() - 1] == '.')) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void RefreshProfileSettings(ProfileBlocking* profile) {
+  if (profile->directory.empty()) {
+    return;
+  }
+  const std::string path = profile->directory + "/blocking-settings.json";
+  const std::string stamp = FileStamp(path);
+  if (profile->settings_read && stamp == profile->settings_stamp) {
+    return;
+  }
+  profile->settings_read = true;
+  profile->settings_stamp = stamp;
+  std::shared_ptr<const BlockingSettings> settings;
+  std::string json;
+  if (stamp.empty()) {
+    settings = std::make_shared<BlockingSettings>();
+  } else if (ReadFile(path, &json)) {
+    settings = ParseBlockingSettings(json);
+  }
+  if (!settings) {
+    // Unreadable settings keep the previous snapshot rather than changing policy.
+    LogBlockingEvent("settings-rejected", "", "");
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_blocking->mutex);
+  profile->settings = std::move(settings);
+}
+
+void RefreshListSet(BlockingState* state, ListSet* lists) {
+  const std::string directory = lists->directory + "/lists";
+  const std::vector<std::string> names =
+      lists->directory.empty() ? std::vector<std::string>() : ListFiles(directory);
+  std::string stamp;
+  for (const std::string& name : names) {
+    stamp += name + "=" + FileStamp(directory + "/" + name) + ";";
+  }
+  if (!state->extra_list.empty()) {
+    stamp += "extra=" + FileStamp(state->extra_list);
+  }
+  if (stamp == lists->stamp) {
+    return;
+  }
+  lists->stamp = stamp;
+  std::string text;
+  for (const std::string& name : names) {
+    std::string part;
+    if (ReadFile(directory + "/" + name, &part)) {
+      text += part + "\n";
+    }
+  }
+  std::string extra;
+  if (!state->extra_list.empty() && ReadFile(state->extra_list, &extra)) {
+    text += extra + "\n";
+  }
+  if (text.empty()) {
+    return;
+  }
+  const auto started = std::chrono::steady_clock::now();
+  void* engine = state->create(text.c_str());
+  if (!engine) {
+    LogBlockingEvent("init-failed", "", "");
+    return;
+  }
+  auto holder = std::make_shared<const BlockingEngine>(engine, state->check,
+                                                        state->release);
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    lists->engine = std::move(holder);
+  }
+  const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now() - started);
+  fprintf(stderr, "{\"bato\":\"blocking\",\"event\":\"ready\","
+                  "\"url\":\"\",\"type\":\"\",\"ms\":%lld,\"bytes\":%zu}\n",
+          static_cast<long long>(elapsed.count()), text.size());
+}
+
+// File thread. Reschedules itself for the life of the process. Settings are cheap and
+// refresh first so a new Profile is not held up by an engine build.
+void RefreshBlocking() {
+  if (g_blocking_stopping) {
+    return;
+  }
+  std::vector<std::shared_ptr<ProfileBlocking>> profiles;
+  std::vector<std::shared_ptr<ListSet>> list_sets;
+  {
+    std::lock_guard<std::mutex> lock(g_blocking->mutex);
+    for (const auto& entry : g_blocking->profiles) profiles.push_back(entry.second);
+    for (const auto& entry : g_blocking->list_sets) list_sets.push_back(entry.second);
+  }
+  for (const auto& profile : profiles) {
+    RefreshProfileSettings(profile.get());
+  }
+  for (const auto& lists : list_sets) {
+    RefreshListSet(g_blocking, lists.get());
+  }
+  if (g_blocking_stopping) {
+    return;
+  }
+  CefPostDelayedTask(TID_FILE_USER_VISIBLE, base::BindOnce(&RefreshBlocking),
+                     kBlockingPollMs);
+}
+
+// Keys name directories, so only the characters of a UUID or a plain name are accepted.
+bool ValidBlockingProfileKey(const std::string& key) {
+  if (key.empty() || key.size() > 64 || key == "lists") {
+    return false;
+  }
+  return std::all_of(key.begin(), key.end(), [](unsigned char c) {
+    return std::isalnum(c) || c == '-' || c == '_';
+  });
+}
+
+// IO thread. The Profile's blocking state, created on its first request.
+std::shared_ptr<ProfileBlocking> BlockingProfileFor(const std::string& key) {
+  std::lock_guard<std::mutex> lock(g_blocking->mutex);
+  auto found = g_blocking->profiles.find(key);
+  if (found != g_blocking->profiles.end()) {
+    return found->second;
+  }
+  const std::string lists_root = g_blocking->root;
+  auto& lists = g_blocking->list_sets[lists_root];
+  if (!lists) {
+    lists = std::make_shared<ListSet>(lists_root);
+  }
+  auto profile = std::make_shared<ProfileBlocking>(
+      lists_root.empty() ? "" : lists_root + "/" + key, lists);
+  if (profile->directory.empty()) {
+    profile->settings = std::make_shared<BlockingSettings>();
+  }
+  g_blocking->profiles[key] = profile;
+  return profile;
+}
+
+void InitializeBlocking() {
+  auto command_line = CefCommandLine::GetGlobalCommandLine();
+  if (g_blocking || command_line->HasSwitch("bato-no-blocking")) {
+    return;
+  }
+  std::string root = command_line->GetSwitchValue("bato-blocking-dir");
+  if (root.empty() && command_line->HasSwitch("bato-workspace-state")) {
+    root = command_line->GetSwitchValue("bato-workspace-state").ToString() +
+           "/blocking";
+  }
+  const std::string extra_list = command_line->GetSwitchValue("bato-blocking");
+  if (root.empty() && extra_list.empty()) {
+    return;
+  }
+  std::string library_path = command_line->GetSwitchValue("bato-blocking-lib");
+  if (library_path.empty()) {
+    CefString exe_dir;
+    if (CefGetPath(PK_DIR_EXE, exe_dir)) {
+      library_path = exe_dir.ToString() + "/../Frameworks/libbato_adblock_ffi.dylib";
+    }
+  }
+  void* library = dlopen(library_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+  auto create = library ? reinterpret_cast<BlockingCreate>(
+                              dlsym(library, "bato_adblock_create"))
+                        : nullptr;
+  auto check = library ? reinterpret_cast<BlockingCheck>(
+                             dlsym(library, "bato_adblock_check"))
+                       : nullptr;
+  auto release = library ? reinterpret_cast<BlockingFree>(
+                               dlsym(library, "bato_adblock_free"))
+                         : nullptr;
+  if (!create || !check || !release) {
+    LogBlockingEvent("init-failed", "", "");
+    return;
+  }
+  auto* state = new BlockingState;
+  state->root = root;
+  state->extra_list = extra_list;
+  state->log_blocked = command_line->HasSwitch("bato-blocking-log");
+  state->create = create;
+  state->check = check;
+  state->release = release;
+  // Optional Swift hooks: list updates and per-page blocked counts.
+  state->page_started = reinterpret_cast<BlockingBrowserHook>(
+      dlsym(RTLD_DEFAULT, "BatoSwiftBlockingPageStarted"));
+  state->blocked = reinterpret_cast<BlockingBrowserHook>(
+      dlsym(RTLD_DEFAULT, "BatoSwiftBlockingRequestBlocked"));
+  auto start = reinterpret_cast<BlockingStart>(
+      dlsym(RTLD_DEFAULT, "BatoSwiftBlockingStart"));
+  if (start && !root.empty()) {
+    start(root.c_str());
+  }
+  g_blocking = state;
+  CefPostTask(TID_FILE_USER_VISIBLE, base::BindOnce(&RefreshBlocking));
+}
+
+// A navigation to a scheme the engine cannot load (mailto:, tel:, an app's own scheme) fails
+// unless the client allows the OS handoff. Allowing it makes Chromium run its own external
+// protocol flow: its per-Profile allow/deny memory and the "Open ...?" confirmation dialog.
+bool IsExternalProtocolRequest(CefRefPtr<CefRequest> request) {
+  CefURLParts parts;
+  if (!CefParseURL(request->GetURL(), parts)) {
+    return false;
+  }
+  static const char* const kEngineSchemes[] = {
+      "http",  "https", "ws",    "wss",         "ftp",          "file",
+      "data",  "blob",  "about", "filesystem",  "chrome",       "chrome-untrusted",
+      "chrome-extension", "chrome-search", "chrome-error", "devtools", "view-source",
+      "javascript"};
+  const std::string scheme = CefString(&parts.scheme).ToString();
+  return !scheme.empty() &&
+         std::find(std::begin(kEngineSchemes), std::end(kEngineSchemes), scheme) ==
+             std::end(kEngineSchemes);
+}
+
+class ExternalProtocolHandler : public CefResourceRequestHandler {
+ public:
+  void OnProtocolExecution(CefRefPtr<CefBrowser> browser,
+                           CefRefPtr<CefFrame> frame,
+                           CefRefPtr<CefRequest> request,
+                           bool& allow_os_execution) override {
+    allow_os_execution = true;
+  }
+
+ private:
+  IMPLEMENT_REFCOUNTING(ExternalProtocolHandler);
+};
+
+class BlockingResourceHandler : public CefResourceRequestHandler {
+ public:
+  BlockingResourceHandler(std::shared_ptr<ProfileBlocking> profile,
+                          std::string source_url,
+                          std::string page_host)
+      : profile_(std::move(profile)),
+        source_url_(std::move(source_url)),
+        page_host_(std::move(page_host)) {}
+
+  // IO thread. Exceptions are checked here, before the engine, so a toggle needs
+  // no list recompile. Fails open: no settings or engine yet, an exception, an invalid URL
+  // or an engine error never blocks.
+  ReturnValue OnBeforeResourceLoad(CefRefPtr<CefBrowser> browser,
+                                   CefRefPtr<CefFrame> frame,
+                                   CefRefPtr<CefRequest> request,
+                                   CefRefPtr<CefCallback> callback) override {
+    std::shared_ptr<const BlockingEngine> engine;
+    std::shared_ptr<const BlockingSettings> settings;
+    {
+      std::lock_guard<std::mutex> lock(g_blocking->mutex);
+      engine = profile_->lists->engine;
+      settings = profile_->settings;
+    }
+    if (!engine || !settings || !settings->enabled ||
+        HostHasException(*settings, page_host_)) {
+      return RV_CONTINUE;
+    }
+    const std::string url = request->GetURL();
+    const char* type = BlockingRequestType(request->GetResourceType());
+    if (engine->check(engine->engine, url.c_str(), source_url_.c_str(), type) <=
+        0) {
+      return RV_CONTINUE;
+    }
+    if (g_blocking->log_blocked) {
+      LogBlockingEvent("blocked", url, type);
+    }
+    if (g_blocking->blocked && browser) {
+      g_blocking->blocked(browser->GetIdentifier());
+    }
+    return RV_CANCEL;
+  }
+
+ private:
+  const std::shared_ptr<ProfileBlocking> profile_;
+  const std::string source_url_;
+  const std::string page_host_;
+  IMPLEMENT_REFCOUNTING(BlockingResourceHandler);
+};
+
